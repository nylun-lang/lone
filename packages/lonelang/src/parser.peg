
{
    package parser
    import (
        "fmt"
        ir "lonelang/src/irtypes"
    )

    func gpanic(rule string, text string) {
        panic(fmt.Sprintf("[Grammar Error] Rule=%s; %s", rule, text))
    }

    func currentPosition(c *current) ir.Position {
        return ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
        }
    }

    func AnyValToType[T any](ref string, v any) T {
        cast, ok := v.(T)
        if !ok {
            panic(fmt.Sprintf("[AnyValToType][%s] expected %T, got %T", ref, *new(T), v))
        }
        return cast
    }

    func AnySliceToSliceOfType[T any](ref string, v any) []T {
        
        s, ok := v.([]any)
        if !ok {
            panic(fmt.Sprintf("[AnySliceToSliceOfType][%s]\nError: cannot cast  slice of type %T as []any", ref, v))
        }

        out := make([]T, len(s))

        for i, e := range s {
            out[i], ok = e.(T)
            if !ok {
                panic(fmt.Sprintf("[AnySliceToSliceOfType][%s]\nError: cannot cast curr el of type %T as %T", ref, e, *new(T)))
            }
        }

        return out
    }

    func AnySliceToString(ref string, chars any) string {
        var b strings.Builder
        chars_list, ok := chars.([]any)
        
        if !ok {
            panic(fmt.Sprintf("[AnySliceToString][%s] cannot cast chars of type %T as []any", ref, chars))
        }
        
        for _, c := range chars_list {
            curr, ok := c.([]byte)
            if !ok {
                panic(fmt.Sprintf("[AnySliceToString][%s] cannot cast curr of type %T as string", ref, curr))
            }
            b.WriteString(string(curr))
        }
        
        return b.String()
    }
}



PROGRAM <- _ IMPORT_LINES _ BODY_LINES _

IMPORT_LINES <- (_ IMPORT_STMT)* 

BODY_LINES <- (_ TOP_LEVEL)*

TOP_LEVEL <- BIND_DEC_STMT / TYPE_DEC_STMT



KW_LET     <- "let"
KW_CONST   <- "const"
KW_TMODIFIER    <- "ro" / "lit"
KW_TSTRUCT <- "struct" / "state" / "record"
KW_TYPE    <- "type"
KW_IF      <- "if"
KW_ELSE    <- "else"
KW_FOR     <- "for"
KW_BREAK   <- "break"
KW_BOOL    <- "true" / "false"
KW_NONE    <- "none"
KW_MATCH   <- "match"
KW_FN      <- "fn"
KW_RETURN  <- "return"
KW_IMPORT  <- "import"
KW_AS      <- "as"

KEYWORD <- 
    KW_LET   
    / KW_CONST
    / KW_TMODIFIER  
    / KW_TSTRUCT
    / KW_TYPE  
    / KW_IF    
    / KW_ELSE  
    / KW_FOR   
    / KW_BREAK 
    / KW_BOOL  
    / KW_NONE  
    / KW_MATCH 
    / KW_FN    
    / KW_RETURN
    / KW_IMPORT
    / KW_AS

IDENTIFIER <- !KEYWORD [a-zA-Z_] [a-zA-Z0-9_]* {
    return c.text, nil
}

EOL <- "\r\n" / "\n"
SPACE <- [ \t]

inline_comment 
<- "--" ("fa:" IDENTIFIER)? (!EOL .)*

multiline_comment 
<- "---" ("fa:" IDENTIFIER)? (!"---" .)*

COMMENT <- (inline_comment / multiline_comment)

_ <- (SPACE / EOL / COMMENT)*



Imp_path <- first:IDENTIFIER rest:(":" IDENTIFIER)* {
    imp_path := []string{
        string(AnyValToType[[]byte]("Imp_path.first", first)),
    }

    if rest != nil {
        for _,pair := range AnyValToType[[]any]("Imp_path.pair", rest) {
            chunk := AnyValToType[[]any]("Imp_path.chunk", pair)[1]
            imp_path = append(
                imp_path,
                string(AnyValToType[[]byte]("Imp_path.chunk_string", chunk)),       
            )
        }
    }

    return imp_path, nil
}

Imp_alias <- KW_AS _ alias:IDENTIFIER { return alias, nil }

Import_classic <- imp:Imp_path _ alias:Imp_alias? {

    imp_path_str := AnyValToType[[]string](
        "Import_classic",
        imp,
    )

    name := imp_path_str[len(imp_path_str)-1]
    if alias != nil {
        name = string(
            AnyValToType[[]byte]("Import_classic.name", alias),
        )
    }

    return ir.ClassicImport{
        Path: imp_path_str,
        Name: name,
    }, nil
}

Imp_picker <- "{" _ items:(":" IDENTIFIER _ Imp_alias?)* _ "}" {
    picked := []ir.ImportPick{}
    
    for _, item := range AnyValToType[[]any]("Imp_picker.item", items) {
        chunk := AnyValToType[[]any]("Imp_picker.chunk", item)
        name := string(AnyValToType[[]byte]("Imp_picker.name", chunk[1]))
        var alias string

        if chunk[3] != nil {
            alias = string(AnyValToType[[]byte]("Imp_picker.alias", chunk[3]))
        }

        picked = append(picked, ir.ImportPick{
            Name: name,
            Alias: alias,
        })
    }

    return picked, nil
}

Import_specific <- imp:Imp_path _ picked:Imp_picker {
    
    imp_path_str := AnyValToType[[]string](
        "Import_specific",
        imp,
    )

    imp_picked := AnyValToType[[]ir.ImportPick](
        "Import_specific",
        picked,
    )

    return ir.SpecificImport{
        Path: imp_path_str,
        Pick: imp_picked,
    }, nil

}

IMPORT_STMT <- KW_IMPORT _ imp:(Import_specific / Import_classic) {

    imp_stmt := ir.ImportStmt{ 
        Value: imp,
        Pos: currentPosition(c),
    }

    if _, is_classic := imp.(ir.ClassicImport); is_classic {
        imp_stmt.Kind = ir.IMP_KIND_CLASSIC
    } else {
        imp_stmt.Kind = ir.IMP_KIND_SPECIFIC
    }

    return imp_stmt, nil
}



Digits <- [0-9]+ ("_" [0-9]+)*

Float <- Digits "." Digits {   
    val, err := strconv.ParseFloat(string(c.text), 64)

    if err != nil {
        gpanic("Float", "cannot parse c.text as float")
    }

    return ir.Literal{
        Kind: ir.LITERAL_FLOAT,
        Value: val,
        Pos: ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
        },
    }, nil
}

Int <- Digits {
    val, err := strconv.Atoi(string(c.text))

    if err != nil {
        gpanic("Int", "cannot parse c.text as integer")
    }

    return ir.Literal{
        Kind: ir.LITERAL_INT,
        Value: val,
        Pos: ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
        },
    }, nil
}

NUMBER <- Float / Int

BOOL <- KW_BOOL {
    val := false
    txt := string(c.text)

    if txt == "true" {
        val = true
    }

    return ir.Literal{
        Kind: ir.LITERAL_BOOL,
        Value: val, 
        Pos: ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
        },
    }, nil
}

NONE <- KW_NONE {
    return ir.Literal{
        Kind: ir.LITERAL_NONE,
        Value: nil,
        Pos: ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
        },
    }, nil
}

Escape <- '\\' cc:(
      '"'
    / '\\'
    / 'n'
    / 'r'
    / 't'
) {
    switch AnyValToType[byte]("Escape.c", cc) {
    case 'n':
        return []byte{'\n'}, nil
    case 'r':
        return []byte{'\r'}, nil
    case 't':
        return []byte{'\t'}, nil
    case '"':
        return []byte{'"'}, nil
    case '\\':
        return []byte{'\\'}, nil
    }
    return nil, fmt.Errorf("invalid escape")
}

Inline_normal_char <- cc:(!('"' / EOL ) .) {
    return AnyValToType[[]any]("Normal_char.c", cc)[1], nil
}

Inline_char <- Escape / Inline_normal_char

STRING <- '"' content:Inline_char* '"' {
    var txt strings.Builder
    
    for _, b := range AnySliceToSliceOfType[[]byte]("STRING.s", content) {
        char := string(b)
        txt.WriteString(char)
    }

    return ir.Literal{
        Kind: ir.LITERAL_STRING,
        Value: txt.String(),
        Pos: ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
        },
    }, nil
}

LITERAL <- NUMBER / BOOL / NONE / STRING



Field_val_list 
    <- list:(_ Field_val_assign)* {
        
        fields := []ir.FieldAssign{}

        for _,r := range AnyValToType[[]any]("Field_val_list.l", list) {
            tuple := AnyValToType[[]any]("Field_val_list.tuple", r)
            fields = append(
                fields, 
                AnyValToType[ir.FieldAssign]("Field_val_list.fields", tuple[1]),
            )
        }

        return fields, nil
    }

Field_val_assign 
    <- "@" field_name:IDENTIFIER _ field_val:EXPR {
        name := AnySliceToString("Field_val_assign.name", []any{field_name})
        expr := AnyValToType[ir.Expr]("Field_val_assign.expr", field_val)

        return ir.FieldAssign{
            Name: name,
            Expr: expr,
        }, nil
    }

OBJECT_LITERAL 
    <- obj_name:IDENTIFIER? "{" _ f:Field_val_list _ "}" {
        
        name := ""
        if obj_name != nil {
            name = AnySliceToString("ObjectLiteral.name", []any{obj_name})
        }

        fields := AnyValToType[[]ir.FieldAssign]("ObjectLiteral.fields", f)

        return ir.ObjectLiteral{
            Name: name,
            Fields: fields,
            Pos: currentPosition(c),
        }, nil
    }

TRAIT_MATERIALIZATION
<- trait_name:IDENTIFIER "|" type_name:IDENTIFIER "|" {
    tr_name := AnyValToType[[]byte]("TRAIT_MATERIALIZATION.tr_name", trait_name)
    tp_name := AnyValToType[[]byte]("TRAIT_MATERIALIZATION.tp_name", type_name)
    return ir.TraitMat{
        TraitName: string(tr_name),
        TypeName: string(tp_name),
        Pos: currentPosition(c),
    }, nil
}

NAME_REF
<- IDENTIFIER {
    return ir.NameRef{ 
        Name: string(c.text),
        Pos: currentPosition(c),
    }, nil
}

PRIMARY_EXPR
<- LITERAL
/ OBJECT_LITERAL
/ TRAIT_MATERIALIZATION
/ NAME_REF
/ "(" _ expr:EXPR _ ")" { return expr, nil }

EXPR_LIST
<- first:EXPR rest:("," _ EXPR)* {
    args := []ir.Expr{
        AnyValToType[ir.Expr]("EXPR_LIST.first", first),
    }

    for _, part := range AnyValToType[[]any]("EXPR_LIST.rest", rest) {
        tuple := AnyValToType[[]any]("EXPR_LIST.part", part)

        args = append(
            args,
            AnyValToType[ir.Expr]("EXPR_LIST.arg", tuple[2]),
        )
    }

    return args, nil
}

Call
<- "(" _ args:EXPR_LIST? _ ")" {
    call_args := []ir.Expr{}

    if args != nil {
        call_args = AnyValToType[[]ir.Expr]("Call.args", args)
    }

    return ir.SuffixCall{
        Args: call_args,
        Pos: currentPosition(c),
    }, nil
}

Member_access <- "." name:IDENTIFIER {
    return ir.SuffixMemberAccess{
        Name: string(AnyValToType[[]byte]("Member_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Namespace_access <- ":" name:IDENTIFIER {
    return ir.SuffixNamespaceAccess{
        Name: string(AnyValToType[[]byte]("Namespace_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Associated_access <- "::" name:IDENTIFIER {
    return ir.SuffixAssociatedAccess{
        Name: string(AnyValToType[[]byte]("Associated_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Postfix_suffix <- 
    Member_access
    / Namespace_access
    / Associated_access
    / Call

POSTFIX_EXPR
<- base:PRIMARY_EXPR suffix:Postfix_suffix* {
    return ir.PostFixExpr{
        Base: AnyValToType[ir.Expr]("POSTFIX_EXPR.base", base),
        Suffix: AnySliceToSliceOfType[ir.Suffix]("POSTFIX_EXPR.suffix", suffix),
        Pos: currentPosition(c),
    }, nil
}

UNARY_OP
<- "-"
/ "+"
/ "!"
/ "&"
/ "*"

UNARY_EXPR
<- op:UNARY_OP _ expr:UNARY_EXPR {
    return ir.UnaryExpr{
        Op:   ir.UnaryOp(string(AnyValToType[[]byte]("UNARY_EXPR.op", op))),
        Expr: AnyValToType[ir.Expr]("UNARY_EXPR.expr", expr),
        Pos:  currentPosition(c),
    }, nil
}
/ POSTFIX_EXPR

EXPR <- UNARY_EXPR

Type_ref_modifier <- mods:(KW_TMODIFIER _)* {
    m := AnyValToType[[]any]("Type_ref_modifier.m", mods)
    t := ir.TypeRefModifier{
            ReadOnly: false,
            LiteralOnly: false,
        }

    for _, pair := range m {
        curr_mod := AnyValToType[[]any]("Type_ref_modifier.curr_mod", pair)[0]
        str := string(AnyValToType[[]byte]("Type_ref_modifier.str", curr_mod))
        if str == "ro" {
            t.ReadOnly = true
        } else if str == "lit" {
            t.LiteralOnly = true
        }
    }

    return t, nil
}

Type_args
    <- "<" _ first:TYPE_REF _ rest:Type_arg_tail* _ ">" {
        
        types := []ir.TypeRef{
            AnyValToType[ir.TypeRef]("Type_args.first", first),
        }

        for _, r := range AnySliceToSliceOfType[ir.TypeRef]("Type_args.rest", rest) {
            types = append(types, r)
        }

        return types, nil
    }

Type_arg_tail
    <- "," _ t:TYPE_REF {
        return AnyValToType[ir.TypeRef]("Type_arg_tail.t", t), nil
    }


TYPE_REF
    <- modifier:Type_ref_modifier _ name:IDENTIFIER _ args:Type_args? {

        n := AnySliceToString("TYPE_REF.n", []any{name})
        a := []ir.TypeRef{}

        if args != nil {
            a = AnyValToType[[]ir.TypeRef]("TYPE_REF.args", args)
        }

        res := ir.TypeRef{
            Name: n,
            Args: a,
            Modifier: AnyValToType[ir.TypeRefModifier]("TYPE_REF.res.Modifier", modifier),
            Pos: currentPosition(c),
        }

        return res, nil
    }




Type_composite_kind <- KW_TSTRUCT {

    value := string(c.text)

    if value == "struct" {
        return ir.COMPOSITE_TYPEOF_STRUCT, nil
    } else if value == "state" {
        return ir.COMPOSITE_TYPEOF_STATE, nil
    } else if value == "record" {
        return ir.COMPOSITE_TYPEOF_RECORD, nil
    }

    gpanic("Type_composite_kind", fmt.Sprintf("unhandled type composite '%s'", value))
    
    return nil, nil
}

Type_composite_field_assign 
    <- field_name:IDENTIFIER _ field_type:TYPE_REF {
        return ir.CompositeTypeField{
            Name: AnySliceToString("Type_composite_field_assign.field_name", []any{field_name}),
            Type: AnyValToType[ir.TypeRef]("Type_composite_field_assign.field_type", field_type),
        }, nil
    }

Type_composite_field_list 
    <- list:(_ Type_composite_field_assign)* {

        fields := []ir.CompositeTypeField{}
        for _, tuple := range AnyValToType[[]any]("Type_composite_field_list.tuple", list) {

            pair := AnyValToType[[]any]("Type_composite_field_list.pair", tuple)
            field := AnyValToType[ir.CompositeTypeField]("Type_composite_field_list.field", pair[1])

            fields = append(fields, field)
        }

        return fields, nil
    }

TYPE_COMPOSITE 
    <- kind:Type_composite_kind _ "{" _ fields:Type_composite_field_list _ "}" {
        
        composite_fieds := AnyValToType[[]ir.CompositeTypeField]("TYPE_COMPOSITE.composite_fieds", fields)
        
        composite_kind := ir.CompositeTypeKind(
            AnyValToType[int]("TYPE_COMPOSITE.composite_kind", kind),
        ) 
        
        return ir.CompositeType{
            Kind: composite_kind,
            Fields: composite_fieds,
            Pos: currentPosition(c),
        }, nil

    }

TYPE_DEC_STMT 
    <- KW_TYPE _ name:IDENTIFIER _ "=" _ construct:(TYPE_REF / TYPE_COMPOSITE) {
        dec := ir.TypeDec{
            Name: string(AnyValToType[[]byte]("", name)),
            Value: construct,
            Pos: currentPosition(c),
        }
        
        if _,ok := construct.(ir.TypeRef); ok {
            dec.Kind = ir.TYPE_DEC_KINDOF_ALIAS
        } else if _, ok := construct.(ir.CompositeType); ok {
            dec.Kind = ir.TYPE_DEC_KINDOF_COMPOSITE
        } else {
            gpanic("TYPE_DEC_STMT", fmt.Sprintf("unhandled type dec construct of shape '%v'", construct))
        }

        return dec, nil
    }

Let_dec <- KW_LET _ name:IDENTIFIER _ type_ref:TYPE_REF {
        let_name := AnySliceToString("Let_dec.let_name", []any{name})
        let_type := AnyValToType[ir.TypeRef]("Let_dec.l_type", type_ref)
        return ir.VariableDec{
            Name: let_name,
            Type: let_type,
            Const: false,
            Pos: currentPosition(c),
        }, nil
    }

Const_dec <- KW_CONST _ name:IDENTIFIER {
        const_name := AnySliceToString("Const_dec.const_name", []any{name})
        const_type := ir.TypeRef{
                Name: "infer",
                Modifier: ir.TypeRefModifier{
                    ReadOnly: true,
                    LiteralOnly: true,
                },
            }

        return ir.VariableDec{
            Name: const_name,
            Type: const_type,
            Const: true,
            Pos: currentPosition(c),
        }, nil
    }

Bind_dec <- Let_dec / Const_dec

Bind_assign
    <- "=" _ expr:EXPR {
        return AnyValToType[ir.Expr]("Bind_assign.expr", expr), nil
    }

BIND_DEC_STMT <- dec:Bind_dec _ val:Bind_assign? {
        
        var_dec := AnyValToType[ir.VariableDec]("BIND_DEC_STMT.var_dec", dec)
        var_dec.Value = ir.Literal{
            Kind: ir.LITERAL_UNINITIALIZED,
            Value: nil,
        }

        if val != nil {
            vcast, ok := val.(ir.Expr)
            if !ok {
                gpanic("BIND_DEC_STMT", "cannot parse received 'Bind_assign' as 'ir.Expr' ")
            }
            var_dec.Value = vcast
        }
        
        return var_dec, nil
    }
