fn search(low: int, high: int, target: int) int {
    while low <= high {
        var mid = low + 1
        if mid == target {
            return mid
        } else if mid < target {
            return mid + 1
        } else {
            return mid - 1
        }
    }
    return -1
}

var first_match = loop: while true {
    if low > 50 {
        break loop: low
    }
}
