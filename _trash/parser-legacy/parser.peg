{
    package parser
    import (
        "strings"
        "fmt"
        lt "lonelang/src/types"
    )
    
    func AnySliceToSliceOfType[T any](ref string, v any) []T {
        
        s, ok := v.([]any)
        if !ok {
            panic(fmt.Sprintf("[AnySliceToSliceOfType][%s]\nError: cannot cast  slice of type %T as []any", ref, v))
        }

        out := make([]T, len(s))

        for i, e := range s {
            out[i], ok = e.(T)
            if !ok {
                panic(fmt.Sprintf("[AnySliceToSliceOfType][%s]\nError: cannot cast curr el of type %T as %T", ref, e, *new(T)))
            }
        }

        return out
    }

    func AnySliceToString(ref string, chars any) string {
        var b strings.Builder
        chars_list, ok := chars.([]any)
        
        if !ok {
            panic(fmt.Sprintf("[AnySliceToString][%s] cannot cast chars of type %T as []any", ref, chars))
        }
        
        for _, c := range chars_list {
            curr, ok := c.([]byte)
            if !ok {
                panic(fmt.Sprintf("[AnySliceToString][%s] cannot cast curr of type %T as string", ref, curr))
            }
            b.WriteString(string(curr))
        }
        
        return b.String()
    }

    func AnyValToType[T any](ref string, v any) T {
        cast, ok := v.(T)
        if !ok {
            panic(fmt.Sprintf("[AnyValToType][%s] expected %T, got %T", ref, *new(T), v))
        }
        return cast
    }
}

Program 
    <- mod:ModLine 
    imp:(ImpLine)*
    body:(BodyLine)+ 
   {

        import_list := []lt.ImportDec{}
        if imp != nil {
            import_list = AnySliceToSliceOfType[lt.ImportDec]("Program.import_list", imp)
        }

        body_list := []any{}
        if body != nil {
            body_list = AnySliceToSliceOfType[any]("Program.body_list", body)
        }
 
        m := AnyValToType[lt.ModuleDec]("Program.mod", mod)

        pg := lt.Program{ 
            Mod: m,
            Imp: import_list,
            Body: body_list,
        }

        return pg, nil
   }

ModLine <- m:ModStmt _ {
    return AnyValToType[lt.ModuleDec]("ModLine.m", m), nil
}

ImpLine <- _ i:ImpStmt _ {
    return AnyValToType[lt.ImportDec]("ImpLine.i", i), nil
}

BodyLine <- _ b:(TopLevel) _ {
    return AnyValToType[any]("BodyLine.b", b), nil
}

TopLevel <- VarDecStmt / TypeDecStmt

EndOfLine <- "\r\n" / "\n"
Space <- [ \t]
_ <- (Space / EndOfLine / Comment)*
WS <- _ / EndOfLine*
Comment <- "//" (!EndOfLine .)*

Identifier <- !Keyword [a-zA-Z] [a-zA-Z0-9_]* {
    return c.text, nil
}

Keyword
    <- (
        k_meta
      / k_var
      / k_literal
      / k_code
      / k_type_modifier
      / k_type_object
    ) ![a-zA-Z0-9_]

k_meta
<- "module" / "import"

k_var
<- "const" / "let" / "type"

k_type_modifier
<- "ro" / "lit"

k_type_object
<- "state" / "record" / "struct"

k_literal
<- "nil" / "undefined" / "true"/ "false"

k_code
<- "if" / "else" / "for" / "while" / "match" / "switch" / "fn" / "pub"

Expr <- Literal / ObjectLiteral

Literal <- String / Number / Bool / None

String <- '"' content:Char* '"' {
    var txt strings.Builder
    // panic(fmt.Sprintf("%v", content)) 
    
    for _, b := range AnySliceToSliceOfType[[]byte]("String.s", content) {
        char := string(b)
        txt.WriteString(char)
    }

    return lt.Literal_String{
        Text: txt.String(),
    }, nil
}

Char <- Escape / NormalChar

NormalChar <- cc:(!'"' .) {
    // panic(fmt.Sprintf("%v", cc)) 
    return AnyValToType[[]any]("NormalChar.c", cc)[1], nil
}

Escape <- '\\' cc:(
      '"'
    / '\\'
    / 'n'
    / 'r'
    / 't'
) {
    switch AnyValToType[byte]("Escape.c", cc) {
    case 'n':
        return []byte{'\n'}, nil
    case 'r':
        return []byte{'\r'}, nil
    case 't':
        return []byte{'\t'}, nil
    case '"':
        return []byte{'"'}, nil
    case '\\':
        return []byte{'\\'}, nil
    }
    return nil, fmt.Errorf("invalid escape")
}


None <- "none" {
    return lt.Literal_Nil{}, nil
}

Bool <- ("true" / "false") {

    val := false
    txt := string(c.text)

    if txt == "true" {
        val = true
    }

    return lt.Literal_Bool{
       Value: val, 
    }, nil
}

Number <- Float / Int

Digits <- [0-9]+ ("_" [0-9]+)*

Float <- Digits "." Digits {     
    return lt.Literal_Number{
        Kind: lt.NUM_KIND_FLOAT,
        Text: string(c.text),
    }, nil
}

Int <- Digits {
    return lt.Literal_Number{
        Kind: lt.NUM_KIND_INT,
        Text: string(c.text),
    }, nil
}

ModStmt <- "module" _ modname:([a-z]+) {
    n := AnySliceToString("ModStmt.n", modname)
    return lt.ModuleDec{
        Name: n,
    }, nil
}

ImpStmt 
    <- "import" _ fisrt:([a-z]+) rest:(("." [a-z]+)*) {
        var pathname strings.Builder
        pathname.WriteString(AnySliceToString("ImpStmt.fisrt", fisrt))

        if rest != nil {
            for _, r := range AnyValToType[[]any]("ImpStmt.rest", rest) {
                pair := AnyValToType[[]any]("ImpStmt.pair", r)
                text := AnySliceToString("ImpStmt.text", pair[1])        
                pathname.WriteString(".")
                pathname.WriteString(text)
            }
        }

        res_path := pathname.String()

        pathslices := strings.Split(res_path, ".")
        last := len(pathslices) - 1
        return lt.ImportDec{
            Path: res_path,
            Alias: pathslices[last],
        }, nil
    }

TypeRef
    <- modif:(TypeRefModifier) _ name:Identifier args:TypeArgs? {

        n := AnySliceToString("TypeRef.n", []any{name})
        a := []lt.TypeRef{}

        if args != nil {
            a = AnyValToType[[]lt.TypeRef]("TypeRef.args", args)
        }

        res := lt.TypeRef{
            Name: n,
            Args: a,
            Modifier: AnyValToType[lt.TypeRefModifier]("TypeRef.res.Modif", modif),
        }

        return res, nil
    }

TypeRefModifier <- mods:(k_type_modifier _)* {
    m := AnyValToType[[]any]("TypeRefModifier.m", mods)
    t := lt.TypeRefModifier{
            ReadOnly: false,
            LiteralOnly: false,
        }

    for _,pair := range m {
        curr_mod := AnyValToType[[]any]("TypeRefModifier.curr_mod", pair)[0]
        str := string(AnyValToType[[]byte]("TypeRefModifier.str", curr_mod))
        if str == "ro" {
            t.ReadOnly = true
        } else if str == "lit" {
            t.LiteralOnly = true
        }
    }

    return t, nil
}

TypeArgs
    <- "<" _ first:TypeRef _ rest:TypeArgTail* _ ">" {
        
        types := []lt.TypeRef{
            AnyValToType[lt.TypeRef]("TypeArgs.first", first),
        }

        for _, r := range AnySliceToSliceOfType[lt.TypeRef]("TypeArgs.rest", rest) {
            types = append(types, r)
        }

        return types, nil
    }

TypeArgTail
    <- "," _ t:TypeRef {
        return AnyValToType[lt.TypeRef]("TypeArgTail.t", t), nil
    }

TypeDecStmt <- "type" _ name:Identifier _ "=" _ construct:(TypeRef / ObjTypeConstruct) {
    is_obj := false
    if _, ok := construct.(lt.ObjectType); ok {
        is_obj = ok
    }

    n := string(AnyValToType[[]byte]("TypeDec.n", name))
    
    return lt.TypeDec{
        Name: n,
        Value: construct,
        IsObj: is_obj,
    }, nil
}

ObjKindConstruct
    <- "struct" {
        return lt.OBJ_KIND_STRUCT, nil
    }
     / "state" {
        return lt.OBJ_KIND_STATE, nil
    }
     / "record" {
        return lt.OBJ_KIND_RECORD, nil
    }

ObjTypeConstruct
    <- kind:ObjKindConstruct _ "{" _ fields:FieldTypeList? _ "}"
    {
        FieldTypeList := []lt.FieldDec{}
        if fields != nil {
            FieldTypeList = AnyValToType[[]lt.FieldDec]("ObjTypeConstruct.FieldTypeList", fields)
        }

        return lt.ObjectType{
            Kind: AnyValToType[lt.ObjectKind]("ObjTypeConstruct.kind", kind),
            Fields: FieldTypeList,
        }, nil
    }

FieldTypeAssignStmt  
    <- field_name:Identifier _ field_type:TypeRef {
        return lt.FieldDec{
            Name: AnySliceToString("FieldTypeAssignStmt.field_name", []any{field_name}),
            Type: AnyValToType[lt.TypeRef]("FieldTypeAssignStmt.field_type", field_type),
        }, nil
    }

FieldTypeList
    <- list:(_ FieldTypeAssignStmt)*
    {
        fields := []lt.FieldDec{}
        for _, tuple := range AnyValToType[[]any]("FieldTypeList.tuple", list) {
            pair := AnyValToType[[]any]("FieldTypeList.pair", tuple)
            field := AnyValToType[lt.FieldDec]("FieldTypeList.field", pair[1])
            fields = append(fields, field)
        }
        return fields, nil
    }

VarDecStmt 
    <-  dec:(ConstDec / LetDec) _ val:AssignStmt?  
    {

        var_dec := AnyValToType[lt.VariableDec]("VarDecStmt.var_dec", dec)
        vcast, ok := val.(lt.Expr)
        if !ok {
            vcast = lt.Literal_Nil{}
        }

        var_dec.Value = vcast
        return var_dec, nil
    }

ConstDec 
    <- "const" _ var_name:Identifier
    {
        v_name := AnySliceToString("VarDec.v_name", []any{var_name})
        v_type := lt.TypeRef{
                Name: "infer",
                Modifier: lt.TypeRefModifier{
                    ReadOnly: true,
                    LiteralOnly: true,
                },
            }

        return lt.VariableDec{
            Name: v_name,
            Type: v_type,
            Const: true,
        }, nil
    }

LetDec 
    <- "let" _ var_name:Identifier _ var_type:TypeRef
    {
        v_name := AnySliceToString("LetDec.v_name", []any{var_name})
        v_type := AnyValToType[lt.TypeRef]("LetDec.v_type", var_type)
        return lt.VariableDec{
            Name: v_name,
            Type: v_type,
            Const: false,
        }, nil
    }

AssignStmt 
    <- "=" _ expr:Expr {
        return AnyValToType[lt.Expr]("AssignStmt.expr", expr), nil
    }

ObjectLiteral 
    <- obj_name:Identifier? "{" _ f:FieldValList? _ "}" {
        name := ""
        if obj_name != nil {
            name = AnySliceToString("ObjectLiteral.name", []any{obj_name})
        }

        fields := []lt.FieldAssign{}       
        if f != nil {
            fields = AnyValToType[[]lt.FieldAssign]("ObjectLiteral.fields", f)
        }

        return lt.ObjectLiteral{
            Name: name,
            Fields: fields,
        }, nil
    }

FieldValList 
    <- list:(_ FieldValAssignStmt)* {
        
        fields := []lt.FieldAssign{}

        for _,r := range AnyValToType[[]any]("ObjectLiteralFields.l", list) {
            tuple := AnyValToType[[]any]("ObjectLiteralFields.tuple", r)
            fields = append(
                fields, 
                AnyValToType[lt.FieldAssign]("ObjectLiteralFields.fields", tuple[1]),
            )
        }

        return fields, nil
    }

FieldValAssignStmt 
    <- "@" field_name:Identifier _ field_val:Expr {
        name := AnySliceToString("FieldValAssignStmt.name", []any{field_name})
        expr := AnyValToType[lt.Expr]("FieldValAssignStmt.expr", field_val)

        return lt.FieldAssign{
            Name: name,
            Expr: expr,
        }, nil
    }





