from std.dataclasses import dataclass, freeze_after_init


type User = dataclass(struct {
  name string

})`

---fa:docs
@description
Insert a float in an already sorted array
---
fn insert_sort (t ref[list[float]], x float) none {
  #append(to=t, val=x)
  let i = #len(t) - 1
  while i > 0 and t[i-1] > t[i] {
    t[i] = t[i-1]
  }
  t[i] = x
}
