{
    package loneparser

    import (
        ir "lone/pkg/lone-parser-ast"
        "fmt"
        "strconv"
        "strings"
    )

    func currentPosition(c *current) ir.Position {
        return ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
            Offset: c.pos.offset,
        }
    }

    func gpanic(rule string, text string) {
        panic(fmt.Sprintf("[Grammar Error] Rule=%s; %s", rule, text))
    }

    func printError(p ir.Position, rawInput string, msg string) {
        content := "[Error]: internal parse error\n%s\n> %d:%d | %s"
        fmt.Printf(content, msg, p.Line, p.Col, rawInput)
    }

    func AnyValToType[T any](ref string, v any) T {
        cast, ok := v.(T)
        if !ok {
            panic(fmt.Sprintf("[AnyValToType][%s] expected %T, got %T", ref, *new(T), v))
        }
        return cast
    }

    func AnySliceToSliceOfType[T any](ref string, v any) []T {
        
        s, ok := v.([]any)
        if !ok {
            panic(fmt.Sprintf("[AnySliceToSliceOfType][%s]\nError: cannot cast  slice of type %T as []any", ref, v))
        }

        out := make([]T, len(s))

        for i, e := range s {
            out[i], ok = e.(T)
            if !ok {
                panic(fmt.Sprintf("[AnySliceToSliceOfType][%s]\nError: cannot cast curr el of type %T as %T", ref, e, *new(T)))
            }
        }

        return out
    }

    func AnySliceToString(ref string, chars any) string {
        var b strings.Builder
        chars_list, ok := chars.([]any)
        
        if !ok {
            panic(fmt.Sprintf("[AnySliceToString][%s] cannot cast chars of type %T as []any", ref, chars))
        }
        
        for _, c := range chars_list {
            curr, ok := c.([]byte)
            if !ok {
                panic(fmt.Sprintf("[AnySliceToString][%s] cannot cast curr of type %T as string", ref, curr))
            }
            b.WriteString(string(curr))
        }
        
        return b.String()
    }

    func FoldBinaryExpr(ref string, c *current, head any, rest any) ir.Expr {
        
        curr := AnyValToType[ir.Expr](
            fmt.Sprintf("%s.left", ref),
            head,
        )

        tail := AnyValToType[[]any](
            fmt.Sprintf("%s.tail", ref),
            rest,
        )

        if len(tail) == 0 {
            return curr
        }

        for _, part := range tail {
            tuple := AnyValToType[[]any](
                fmt.Sprintf("%s.tuple", ref),
                part,
            )

            opBytes := AnyValToType[[]byte](fmt.Sprintf("%s.op", ref), tuple[1])
            op := ir.BinaryOp(string(opBytes))

            right := AnyValToType[ir.Expr](
                fmt.Sprintf("%s.right", ref),
                tuple[3],
            )

            curr = ir.BinaryExpr{
                Op: op,
                Left: curr,
                Right: right,
                Pos: currentPosition(c),
            }
        }

        return curr
    }

    type packedIfArm struct {
        cond ir.Expr
        body ir.Block
        pos  ir.Position
    }

    func toBlock(val any, defaultPos ir.Position) ir.Block {
        switch b := val.(type) {
        case ir.Block:
            return b
        case *ir.Block:
            if b != nil {
                return *b
            }
            return ir.Block{Pos: defaultPos}
        default:
            pos := defaultPos
            if p, ok := val.(interface{ Pos() ir.Position }); ok {
                pos = p.Pos()
            }
            return ir.Block{
                Stmts: []any{val},
                Pos:   pos,
            }
        }
    }
}

PROGRAM <- decls:(_ TOP_LEVEL)* _ EOF {
    return decls, nil
}

EOF <- !.

TOP_LEVEL <- COMPILER_DIRECTIVE / IMPORT_STMT / TYPE_DEC / IMPL_DEC / BIND_DEC / FN_DEC / IF_STMT / WHILE_STMT / LOOP_STMT / FOR_STMT / LABEL_DEC / DROP_STMT

COMPILER_DIRECTIVE <- FA_DIRECTIVE / LEGACY_WASM_DIRECTIVE

FA_DIRECTIVE <- FA_DIRECTIVE_BLOCK / FA_DIRECTIVE_STMT / FA_DIRECTIVE_BARE

FA_DIRECTIVE_BLOCK <- "@" _ "fa:" name:IDENTIFIER _ "{" imports:(_ IMPORT_STMT)* _ "}" {
    nameBytes := AnyValToType[[]byte]("FA_DIRECTIVE_BLOCK.name", name)
    var impList []ir.ImportDecl
    if rawSlice, ok := imports.([]any); ok {
        for _, item := range rawSlice {
            if tuple, ok := item.([]any); ok && len(tuple) >= 2 {
                if imp, ok := tuple[1].(ir.ImportDecl); ok {
                    impList = append(impList, imp)
                }
            }
        }
    }
    return ir.WasmDirective{
        Name:    string(nameBytes),
        Imports: impList,
        Inline:  false,
        Pos:     currentPosition(c),
    }, nil
}

FA_DIRECTIVE_STMT <- "@" _ "fa:" name:IDENTIFIER _ imp:IMPORT_STMT {
    nameBytes := AnyValToType[[]byte]("FA_DIRECTIVE_STMT.name", name)
    impDecl := AnyValToType[ir.ImportDecl]("FA_DIRECTIVE_STMT.imp", imp)
    return ir.WasmDirective{
        Name:    string(nameBytes),
        Imports: []ir.ImportDecl{impDecl},
        Inline:  false,
        Pos:     currentPosition(c),
    }, nil
}

FA_DIRECTIVE_BARE <- "@" _ "fa:" name:IDENTIFIER _SPACE* (_EOL / EOF) {
    nameBytes := AnyValToType[[]byte]("FA_DIRECTIVE_BARE.name", name)
    return ir.WasmDirective{
        Name:    string(nameBytes),
        Inline:  true,
        Pos:     currentPosition(c),
    }, nil
}

LEGACY_WASM_DIRECTIVE <- LEGACY_WASM_BLOCK / LEGACY_WASM_INLINE

LEGACY_WASM_BLOCK <- "---fa:wasm" ![a-zA-Z0-9_] imports:(_DIRECTIVE_WS IMPORT_STMT)* _DIRECTIVE_WS "---" {
    var impList []ir.ImportDecl
    if rawSlice, ok := imports.([]any); ok {
        for _, item := range rawSlice {
            if tuple, ok := item.([]any); ok && len(tuple) >= 2 {
                if imp, ok := tuple[1].(ir.ImportDecl); ok {
                    impList = append(impList, imp)
                }
            }
        }
    }
    return ir.WasmDirective{
        Name:    "wasm",
        Imports: impList,
        Inline:  false,
        Pos:     currentPosition(c),
    }, nil
}

LEGACY_WASM_INLINE <- "--fa:wasm" ![a-zA-Z0-9_] _SPACE* (_EOL / EOF) {
    return ir.WasmDirective{
        Name:   "wasm",
        Inline: true,
        Pos:    currentPosition(c),
    }, nil
}

IMPORT_STMT <- IMPORT_SYMBOLS_STMT / IMPORT_ALIAS_STMT

IMPORT_SYMBOLS_STMT <- KW_IMPORT _ symbols:IMPORT_SYMBOL_LIST _ KW_FROM _ src:IMPORT_SOURCE {
    symList := AnyValToType[[]string]("IMPORT_SYMBOLS_STMT.symbols", symbols)
    sourceStr := AnyValToType[string]("IMPORT_SYMBOLS_STMT.src", src)
    isNs := strings.HasPrefix(sourceStr, ":")
    return ir.ImportDecl{
        Symbols:     symList,
        Source:      sourceStr,
        IsNamespace: isNs,
        Pos:         currentPosition(c),
    }, nil
}

IMPORT_ALIAS_STMT <- KW_IMPORT _ src:IMPORT_SOURCE _ KW_AS _ alias:IDENTIFIER {
    sourceStr := AnyValToType[string]("IMPORT_ALIAS_STMT.src", src)
    aliasBytes := AnyValToType[[]byte]("IMPORT_ALIAS_STMT.alias", alias)
    isNs := strings.HasPrefix(sourceStr, ":")
    return ir.ImportDecl{
        Source:      sourceStr,
        IsNamespace: isNs,
        Alias:       string(aliasBytes),
        Pos:         currentPosition(c),
    }, nil
}

IMPORT_SYMBOL_LIST <- first:IMPORT_SYMBOL rest:(_ "," _ IMPORT_SYMBOL)* (_ ",")? {
    f := AnyValToType[string]("IMPORT_SYMBOL_LIST.first", first)
    list := []string{f}
    if restSlice, ok := rest.([]any); ok {
        for _, item := range restSlice {
            if tuple, ok := item.([]any); ok && len(tuple) >= 4 {
                sym := AnyValToType[string]("IMPORT_SYMBOL_LIST.rest", tuple[3])
                list = append(list, sym)
            }
        }
    }
    return list, nil
}

IMPORT_SYMBOL <- "." id:IDENTIFIER {
    idBytes := AnyValToType[[]byte]("IMPORT_SYMBOL.id", id)
    return string(idBytes), nil
}

IMPORT_SOURCE <- NAMESPACE_SOURCE / RELATIVE_SOURCE

NAMESPACE_SOURCE <- ":" IDENTIFIER (":" IDENTIFIER)* {
    return string(c.text), nil
}

RELATIVE_SOURCE <- "."+ [a-zA-Z0-9_./-]* {
    return string(c.text), nil
}

KW_IMPORT <- "import" ![a-zA-Z0-9_]
KW_FROM <- "from" ![a-zA-Z0-9_]
KW_AS <- "as" ![a-zA-Z0-9_]
KW_PUB <- "pub" ![a-zA-Z0-9_]
KW_FN <- "fn" ![a-zA-Z0-9_]
KW_VAR <- "var" ![a-zA-Z0-9_]
KW_LET <- "let" ![a-zA-Z0-9_]
KW_TYPE <- "type" ![a-zA-Z0-9_]
KW_STRUCT <- "struct" ![a-zA-Z0-9_]
KW_TRAIT <- "trait" ![a-zA-Z0-9_]
KW_IMPL <- "impl" ![a-zA-Z0-9_]
KW_ON <- "on" ![a-zA-Z0-9_]
KW_NONE <- "none" ![a-zA-Z0-9_]
KW_BOOL <- ("true" / "false") ![a-zA-Z0-9_]
KW_READONLY <- "ro" ![a-zA-Z0-9_]
KW_COMPTIME <- "comptime" ![a-zA-Z0-9_]
KW_RETURN <- "return" ![a-zA-Z0-9_]
KW_BREAK <- "break" ![a-zA-Z0-9_]
KW_IF <- "if" ![a-zA-Z0-9_]
KW_ELSE <- "else" ![a-zA-Z0-9_]
KW_WHILE <- "while" ![a-zA-Z0-9_]
KW_LOOP <- "loop" ![a-zA-Z0-9_]
KW_FOR <- "for" ![a-zA-Z0-9_]
KW_IN <- "in" ![a-zA-Z0-9_]
KW_DROP <- "drop" ![a-zA-Z0-9_]
KW_AND <- "and" ![a-zA-Z0-9_]
KW_OR <- "or" ![a-zA-Z0-9_]
KW_XOR <- "xor" ![a-zA-Z0-9_]
KW_IS <- "is" ![a-zA-Z0-9_]
KW_NOT <- "not" ![a-zA-Z0-9_]

KEYWORD <- 
    KW_IMPORT /
    KW_FROM /
    KW_AS /
    KW_PUB /
    KW_VAR /
    KW_LET /
    KW_TYPE /
    KW_STRUCT /
    KW_TRAIT /
    KW_IMPL /
    KW_FN /
    KW_BOOL /
    KW_NONE /
    KW_READONLY /
    KW_COMPTIME /
    KW_RETURN /
    KW_BREAK /
    KW_IF /
    KW_ELSE /
    KW_WHILE /
    KW_LOOP /
    KW_FOR /
    KW_IN /
    KW_DROP /
    KW_AND /
    KW_OR /
    KW_XOR /
    KW_IS /
    KW_NOT

FN_NAME <- "#"? IDENTIFIER {
    return string(c.text), nil
}

IDENTIFIER <- !KEYWORD [a-zA-Z_] [a-zA-Z0-9_]* {
    return c.text, nil
}

_EOL <- "\r\n" / "\n"
_SPACE <- [ \t]
_INLINE_COMMENT     <- "--" !"-" !("fa:wasm" ![a-zA-Z0-9_]) (!_EOL .)*
_MULTI_LINE_COMMENT <- "---" !("fa:wasm" ![a-zA-Z0-9_]) (!"---" .)* "---"
_COMMENT <- (_MULTI_LINE_COMMENT / _INLINE_COMMENT)
_INLINE_WS <- (_SPACE / _INLINE_COMMENT)*
_DIRECTIVE_WS <- (!"---" (_SPACE / _EOL / _INLINE_COMMENT))*

_ <- (_SPACE / _EOL / _COMMENT)*




Digits <- [0-9]+ ("_" [0-9]+)*

Float <- Digits "." Digits {   
    val, err := strconv.ParseFloat(string(c.text), 64)

    if err != nil {
        gpanic("Float", "cannot parse c.text as float")
    }

    return ir.Literal{
        Kind: ir.LITERAL_FLOAT,
        Value: val,
        Pos: currentPosition(c),
    }, nil
}

Int <- Digits {
    val, err := strconv.Atoi(string(c.text))

    if err != nil {
        gpanic("Int", "cannot parse c.text as integer")
    }

    return ir.Literal{
        Kind: ir.LITERAL_INT,
        Value: val,
        Pos: currentPosition(c),
    }, nil
}

NUMBER <- Float / Int

BOOL <- KW_BOOL {
    val := false
    txt := string(c.text)

    if txt == "true" {
        val = true
    }

    return ir.Literal{
        Kind: ir.LITERAL_BOOL,
        Value: val, 
        Pos: currentPosition(c),
    }, nil
}

NONE <- KW_NONE {
    return ir.Literal{
        Kind: ir.LITERAL_NONE,
        Value: nil,
        Pos: ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
        },
    }, nil
}

Escape <- '\\' cc:(
      '"'
    / '\\'
    / 'n'
    / 'r'
    / 't'
) {
    var b byte
    if slice, ok := cc.([]byte); ok && len(slice) > 0 {
        b = slice[0]
    } else if bVal, ok := cc.(byte); ok {
        b = bVal
    } else {
        b = AnyValToType[byte]("Escape.c", cc)
    }
    switch b {
    case 'n':
        return []byte{'\n'}, nil
    case 'r':
        return []byte{'\r'}, nil
    case 't':
        return []byte{'\t'}, nil
    case '"':
        return []byte{'"'}, nil
    case '\\':
        return []byte{'\\'}, nil
    }
    return nil, fmt.Errorf("invalid escape")
}

Inline_normal_char <- cc:(!('"' / _EOL ) .) {
    return AnyValToType[[]any]("Normal_char.c", cc)[1], nil
}

Inline_char <- Escape / Inline_normal_char

STRING <- '"' content:Inline_char* '"' {
    var txt strings.Builder
    
    for _, b := range AnySliceToSliceOfType[[]byte]("STRING.s", content) {
        char := string(b)
        txt.WriteString(char)
    }

    return ir.Literal{
        Kind: ir.LITERAL_STRING,
        Value: txt.String(),
        Pos: currentPosition(c),
    }, nil
}

LITERAL <- NUMBER / BOOL / NONE / STRING


NAME_REF <- "#"? IDENTIFIER {
    return ir.NameRef{
        Name: string(c.text),
        Pos: currentPosition(c),
    }, nil
}

Field_val_list 
    <- first:Field_val_assign 
       list:(_ "," _ Field_val_assign)* 
       (_ ",")?
       {
        
        fields := []ir.FieldAssign{
            AnyValToType[ir.FieldAssign]("Field_val_list.first", first),
        }

        for _,r := range AnyValToType[[]any]("Field_val_list.l", list) {
            tuple := AnyValToType[[]any]("Field_val_list.tuple", r)
            fields = append(
                fields, 
                AnyValToType[ir.FieldAssign]("Field_val_list.fields", tuple[3]),
            )
        }

        return fields, nil
    }

Field_val_assign 
    <- "." field_name:IDENTIFIER (_ ":" _ / _SPACE+) field_val:EXPR {
        name := AnySliceToString("Field_val_assign.name", []any{field_name})
        expr := AnyValToType[ir.Expr]("Field_val_assign.expr", field_val)

        return ir.FieldAssign{
            Name: name,
            Expr: expr,
        }, nil
    }

OBJECT_LITERAL 
    <- "{" _ f:Field_val_list _ "}" {
        fields := AnyValToType[[]ir.FieldAssign]("ObjectLiteral.fields", f)
        return ir.ObjectLiteral{
            Fields: fields,
            Pos: currentPosition(c),
        }, nil
    }

EXPR_LIST
<- first:EXPR rest:(_ "," _ EXPR)* (_ ",")? {
    args := []ir.Expr{
        AnyValToType[ir.Expr]("EXPR_LIST.first", first),
    }

    for _, part := range AnyValToType[[]any]("EXPR_LIST.rest", rest) {
        tuple := AnyValToType[[]any]("EXPR_LIST.part", part)

        args = append(
            args,
            AnyValToType[ir.Expr]("EXPR_LIST.arg", tuple[3]),
        )
    }

    return args, nil
}

LIST_LITERAL 
    <- "{" _ exprs:EXPR_LIST _ "}" {
        content := AnyValToType[[]ir.Expr]("ListLiteral.exprs", exprs)
        return ir.ListLiteral{
            Content: content,
            Pos: currentPosition(c),
        }, nil
    }

PRIMARY_EXPR <- 
    LABEL_DEC
    / IF_STMT
    / WHILE_STMT
    / BREAK_STMT
    / DROP_STMT
    / LITERAL 
    / NAME_REF 
    / OBJECT_LITERAL
    / LIST_LITERAL
    / "(" _ expr:EXPR _ ")" { return expr, nil }

Call
<- "(" _ args:EXPR_LIST? _ ")" {
    call_args := []ir.Expr{}

    if args != nil {
        call_args = AnyValToType[[]ir.Expr]("Call.args", args)
    }

    return ir.SuffixCall{
        Args: call_args,
        Pos: currentPosition(c),
    }, nil
}

Member_access <- "." name:IDENTIFIER {
    return ir.SuffixMemberAccess{
        Name: string(AnyValToType[[]byte]("Member_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Namespace_access <- ":" name:IDENTIFIER {
    return ir.SuffixNamespaceAccess{
        Name: string(AnyValToType[[]byte]("Namespace_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Associated_access <- "::" name:IDENTIFIER {
    return ir.SuffixAssociatedAccess{
        Name: string(AnyValToType[[]byte]("Associated_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Call_type_init <- "::" expr:Call {
    call := ir.SuffixCallTypeInit(AnyValToType[ir.SuffixCall]("Call_type_init.call", expr))
    return call, nil
}

Call_type_make <- "::" data:(OBJECT_LITERAL / LIST_LITERAL) {
    _, is_obj := data.(ir.ObjectLiteral)
    call := ir.SuffixCallTypeMake{
        Arg: data,
        Pos: currentPosition(c),
    }
    
    if is_obj {
        call.Kind = ir.CALL_TYPE_MAKE_OBJ
    } else {
        call.Kind = ir.CALL_TYPE_MAKE_LIST
    }

    return call, nil
}

Trait_materialize <- "::|" _ target:TYPE_REF _ "|" {
    return ir.SuffixTraitMat{
        TargetType: AnyValToType[ir.TYPE_REF]("Trait_materialize.target", target),
        Pos:        currentPosition(c),
    }, nil
}

Index_access <- "[" _ idx:EXPR _ "]" {
    return ir.SuffixIndex{
        Index: AnyValToType[ir.Expr]("Index_access.idx", idx),
        Pos:   currentPosition(c),
    }, nil
}

Postfix_suffix <- 
    Member_access
    / Namespace_access
    / Trait_materialize
    / Associated_access
    / Call
    / Call_type_init
    / Call_type_make
    / Index_access


POSTFIX_EXPR
<- base:PRIMARY_EXPR suffix:Postfix_suffix* {
    return ir.PostFixExpr{
        Base: AnyValToType[ir.Expr]("POSTFIX_EXPR.base", base),
        Suffix: AnySliceToSliceOfType[ir.Suffix]("POSTFIX_EXPR.suffix", suffix),
        Pos: currentPosition(c),
    }, nil
}

UNARY_OP
<- "-"
/ "+"
/ "!"
/ "&raw"
/ "&"
/ "*"

UNARY_EXPR
<- op:UNARY_OP _ expr:UNARY_EXPR {
    return ir.UnaryExpr{
        Op:   ir.UnaryOp(string(AnyValToType[[]byte]("UNARY_EXPR.op", op))),
        Expr: AnyValToType[ir.Expr]("UNARY_EXPR.expr", expr),
        Pos:  currentPosition(c),
    }, nil
}
/ POSTFIX_EXPR

MUL_BINARY_EXPR 
<- left:UNARY_EXPR right:(_ ("*" / "/" / "%") _ UNARY_EXPR)* {
    expr := FoldBinaryExpr("MUL_BINARY_EXPR", c, left, right)
    return expr, nil
} / UNARY_EXPR


ADD_BINARY_EXPR 
<- left:MUL_BINARY_EXPR right:(_ ("+" / "-") _ MUL_BINARY_EXPR)* {
    expr := FoldBinaryExpr("ADD_BINARY_EXPR", c, left, right)
    return expr, nil
} 

Comparision_Op 
<- ">="
/  "<="
/  ">"
/  "<"

COMPARISION_BINARY_EXPR 
<- left:ADD_BINARY_EXPR right:(_ Comparision_Op _ ADD_BINARY_EXPR)* {
    tail := AnyValToType[[]any]("COMPARISION_BINARY_EXPR.tail", right)
    if len(tail) > 1 {
        return nil, fmt.Errorf("comparison operators cannot be chained")
    }
    expr := FoldBinaryExpr("COMPARISION_BINARY_EXPR", c, left, right)
    return expr, nil
}

IS_EXPR 
<- expr:COMPARISION_BINARY_EXPR isTail:(_ KW_IS not:(_ KW_NOT)? _ target:TYPE_REF)? {
    if isTail == nil {
        return expr, nil
    }
    tailList := AnyValToType[[]any]("IS_EXPR.tail", isTail)
    negated := tailList[2] != nil
    targetRef := AnyValToType[ir.TYPE_REF]("IS_EXPR.target", tailList[4])
    return ir.IsExpr{
        Expr:       AnyValToType[ir.Expr]("IS_EXPR.expr", expr),
        TargetType: targetRef,
        Negated:    negated,
        Pos:        currentPosition(c),
    }, nil
}

Equality_Op
<- "=="
/  "!="

EQUALITY_BINARY_EXPR 
<- left:IS_EXPR right:(_ Equality_Op _ IS_EXPR)* {
    expr := FoldBinaryExpr("EQUALITY_BINARY_EXPR", c, left, right)
    return expr, nil
}

BITWISE_AND_BINARY_EXPR 
<- left:EQUALITY_BINARY_EXPR right:(_ "&" !"&" _ EQUALITY_BINARY_EXPR)* {
    expr := FoldBinaryExpr("BITWISE_AND_BINARY_EXPR", c, left, right)
    return expr, nil
}

BITWISE_XOR_BINARY_EXPR 
<- left:BITWISE_AND_BINARY_EXPR right:(_ "^" _ BITWISE_AND_BINARY_EXPR)* {
    expr := FoldBinaryExpr("BITWISE_XOR_BINARY_EXPR", c, left, right)
    return expr, nil
}

BITWISE_OR_BINARY_EXPR 
<- left:BITWISE_XOR_BINARY_EXPR right:(_ "|" !"|" _ BITWISE_XOR_BINARY_EXPR)* {
    expr := FoldBinaryExpr("BITWISE_OR_BINARY_EXPR", c, left, right)
    return expr, nil
}

Logical_And_Op <- ("and" ![a-zA-Z0-9_] / "&&") {
    return c.text, nil
}

LOGICAL_AND_BINARY_EXPR 
<- left:BITWISE_OR_BINARY_EXPR right:(_ Logical_And_Op _ BITWISE_OR_BINARY_EXPR)* {
    expr := FoldBinaryExpr("LOGICAL_AND_BINARY_EXPR", c, left, right)
    return expr, nil
}

Logical_Xor_Op <- "xor" ![a-zA-Z0-9_] {
    return c.text, nil
}

LOGICAL_XOR_BINARY_EXPR 
<- left:LOGICAL_AND_BINARY_EXPR right:(_ Logical_Xor_Op _ LOGICAL_AND_BINARY_EXPR)* {
    expr := FoldBinaryExpr("LOGICAL_XOR_BINARY_EXPR", c, left, right)
    return expr, nil
}

Logical_Or_Op <- ("or" ![a-zA-Z0-9_] / "||") {
    return c.text, nil
}

LOGICAL_OR_BINARY_EXPR 
<- left:LOGICAL_XOR_BINARY_EXPR right:(_ Logical_Or_Op _ LOGICAL_XOR_BINARY_EXPR)* {
    expr := FoldBinaryExpr("LOGICAL_OR_BINARY_EXPR", c, left, right)
    return expr, nil
}

EXPR <- LOGICAL_OR_BINARY_EXPR

TYPE_REF_ARGS <- 
    "<"
    _
    first:TYPE_REF
    rest:(_ "," _ TYPE_REF)*
    _
    ">" {
        result := []any{first}
        rest_list := AnyValToType[[]any]("TYPE_REF_ARGS.rest_list", rest)
        for _, tuple := range(rest_list) {
            arg := AnyValToType[[]any]("TYPE_REF_ARGS.arg", tuple)[3]
            result = append(result, arg)
        }
        return result, nil
    }

TYPE_NAME_IDENT <- (IDENTIFIER / "none" ![a-zA-Z0-9_]) {
    return c.text, nil
}

TYPE_BASE <- 
    name:TYPE_NAME_IDENT
    args:TYPE_REF_ARGS? {
        var type_args []ir.TYPE_REF = []ir.TYPE_REF{}
        if args != nil {
            type_args = AnySliceToSliceOfType[ir.TYPE_REF]("TYPE_BASE.type_args", args)
        }

        return ir.TypeBase{
            Name: string(AnyValToType[[]uint8]("TYPE_BASE.name", name)),
            Args: type_args,
        }, nil
    }

TYPE_LIST <- 
    "[" 
    _ 
    size:EXPR?
    _
    "]" 
    _ 
    elem:TYPE_REF {
        var list_size ir.Expr = ir.Literal{
            Kind: ir.LITERAL_DYNAMIC_SIZE,
            Pos: currentPosition(c),
        }

        if size != nil {
            list_size = AnyValToType[ir.Expr]("TYPE_LIST.size", size)
        }

        itemType := AnyValToType[ir.TYPE_REF]("TYPE_LIST.elem", elem)
        return ir.TypeList{
            Size: list_size,
            ItemType: itemType,
        }, nil
    }

SELF_PARAM <- "self" ![a-zA-Z0-9_] !(_ ":" / _SPACE+ TYPE_REF) {
    return ir.FnParam{
        Name: "self",
        Type: ir.TYPE_REF{
            Pos:  currentPosition(c),
            Kind: ir.TYPE_BASE,
            Value: ir.TypeBase{
                Name: "Self",
                Args: []ir.TYPE_REF{},
            },
        },
    }, nil
}

TYPED_FN_PARAM <- 
    name:(IDENTIFIER (_ ":" _ / _SPACE+))? 
    ptype:TYPE_REF {
        param_name := ""
        if name != nil {
            n := AnyValToType[[]any]("FN_PARAM.name", name)[0]
            param_name = string(AnyValToType[[]uint8]("FN_PARAM.name_str", n))
        }
        param_type := AnyValToType[ir.TYPE_REF]("FN_PARAM.ptype", ptype)
        return ir.FnParam{
            Name: param_name,
            Type: param_type,
        }, nil
    }

FN_PARAM <- SELF_PARAM / TYPED_FN_PARAM

FN_PARAM_LIST <- 
    first:FN_PARAM 
    rest:(_ "," _ FN_PARAM)* 
    (_ ",")? {
        result := []ir.FnParam{
            AnyValToType[ir.FnParam]("FN_PARAM_LIST.first", first),
        }
        if rest != nil {
            rest_list := AnyValToType[[]any]("FN_PARAM_LIST.rest_list", rest)
            for _, tuple := range rest_list {
                p := AnyValToType[[]any]("FN_PARAM_LIST.tuple", tuple)[3]
                result = append(result, AnyValToType[ir.FnParam]("FN_PARAM_LIST.p", p))
            }
        }
        return result, nil
    }

TYPE_FN <- 
    KW_FN 
    _ 
    "(" 
    _ 
    params:FN_PARAM_LIST? 
    _ 
    ")" 
    ret:(_ TYPE_REF)? {
        var fn_params []ir.FnParam = []ir.FnParam{}
        if params != nil {
            fn_params = AnyValToType[[]ir.FnParam]("TYPE_FN.params", params)
        }

        var return_type *ir.TYPE_REF
        if ret != nil {
            r := AnyValToType[[]any]("TYPE_FN.ret", ret)[1]
            t := AnyValToType[ir.TYPE_REF]("TYPE_FN.ret_type", r)
            return_type = &t
        }

        return ir.TypeFn{
            Params: fn_params,
            ReturnType: return_type,
        }, nil
    }

TYPE_ACTUAL <- TYPE_FN / TYPE_LIST / TYPE_BASE

TYPE_REF <- 
    is_comptime:KW_COMPTIME?
    _
    is_readonly:KW_READONLY? 
    _ 
    is_optional:"?"? 
    _
    actual:TYPE_ACTUAL {
        constrain := ir.TypeConstrain{
            Comptime: is_comptime != nil,
            ReadOnly: is_readonly != nil,
            Optional: is_optional != nil,
        }

        var kind ir.TypeRefKind
        switch actual.(type) {
        case ir.TypeBase:
            kind = ir.TYPE_BASE
        case ir.TypeList:
            kind = ir.TYPE_LIST
        case ir.TypeFn:
            kind = ir.TYPE_FN
        default:
            gpanic("TYPE_REF", fmt.Sprintf("unexpected type %T", actual))
        }

        return ir.TYPE_REF{
            Pos: currentPosition(c),
            Kind: kind,
            Constrain: constrain,
            Value: actual,
        }, nil
    }

BIND_TYPE_ANNOT <- _ ":" _ tr:TYPE_REF {
    return tr, nil
} / _SPACE+ tr:TYPE_REF {
    return tr, nil
}

BIND_DEC <- 
    pub:(KW_PUB _)?
    (KW_VAR / KW_LET)
    _ 
    name:IDENTIFIER 
    vtype:BIND_TYPE_ANNOT?
    value:(_ "=" _ EXPR)? {

    pos := currentPosition(c)
    var resolved ir.Expr
    
    if value != nil {
        val := AnyValToType[[]any]("BIND_DEC.resolved", value)[3]
        resolved = AnyValToType[ir.Expr]("BIND_DEC.resolved", val)
    } else {
        resolved = ir.Literal{ Kind: ir.LITERAL_UNINITIALIZED }
    }

    var resolved_type ir.TYPE_REF
    if vtype != nil {
        resolved_type = AnyValToType[ir.TYPE_REF]("BIND_DEC.resolved_type", vtype)
    } else {
        resolved_type = ir.TYPE_REF{
            Kind: ir.TYPE_BASE,
            Pos: currentPosition(c),
            Constrain: ir.TypeConstrain{},
            Value: ir.TypeBase{
                Name: "infer",
                Args: []ir.TYPE_REF{},
            },
        }
    }

    return ir.BIND_DEC{
        Pos: pos,
        IsPublic: pub != nil,
        Name: string(AnyValToType[[]uint8]("BIND_DEC.name", name)),
        Value: resolved,
        Type: resolved_type,
    }, nil
}

RETURN_STMT <- KW_RETURN expr:(_INLINE_WS EXPR)? {
    var val ir.Expr
    if expr != nil {
        val = AnyValToType[ir.Expr]("RETURN_STMT.val", AnyValToType[[]any]("RETURN_STMT.tuple", expr)[1])
    }
    return ir.ReturnStmt{
        Value: val,
        Pos: currentPosition(c),
    }, nil
}

LABEL_IDENT <- IDENTIFIER / "loop" {
    return c.text, nil
}

BREAK_LABEL <- id:LABEL_IDENT _INLINE_WS ":" !":" {
    return string(AnyValToType[[]uint8]("BREAK_LABEL.id", id)), nil
}

BREAK_STMT <- KW_BREAK label:(_INLINE_WS BREAK_LABEL)? val:(_INLINE_WS EXPR)? {
    var label_name string
    if label != nil {
        label_name = AnyValToType[string]("BREAK_STMT.label", AnyValToType[[]any]("BREAK_STMT.label_tuple", label)[1])
    }

    var break_val ir.Expr
    if val != nil {
        break_val = AnyValToType[ir.Expr]("BREAK_STMT.val", AnyValToType[[]any]("BREAK_STMT.val_tuple", val)[1])
    }

    return ir.BreakStmt{
        Label: label_name,
        Value: break_val,
        Pos: currentPosition(c),
    }, nil
}

ELSE_BRANCH <- KW_ELSE _ branch:(IF_STMT / BLOCK) {
    return branch, nil
}

IF_STMT <- PACKED_IF_STMT / STANDARD_IF_STMT

PACKED_IF_ARM <- !KW_ELSE cond:EXPR _ "=>" _ body:(BLOCK / STMT) _ ("," / ";")? {
    return packedIfArm{
        cond: AnyValToType[ir.Expr]("PACKED_IF_ARM.cond", cond),
        body: toBlock(body, currentPosition(c)),
        pos:  currentPosition(c),
    }, nil
}

PACKED_ELSE_ARM <- KW_ELSE _ "=>" _ body:(BLOCK / STMT) _ ("," / ";")? {
    return toBlock(body, currentPosition(c)), nil
}

PACKED_IF_STMT <- KW_IF _ "{" _ arms:(_ PACKED_IF_ARM)* el:(_ PACKED_ELSE_ARM)? _ "}" {
    var armList []packedIfArm
    if arms != nil {
        rawSlice := AnyValToType[[]any]("PACKED_IF_STMT.arms", arms)
        for _, item := range rawSlice {
            if tuple, ok := item.([]any); ok && len(tuple) >= 2 {
                if a, ok := tuple[1].(packedIfArm); ok {
                    armList = append(armList, a)
                }
            }
        }
    }

    var elseBranch any
    if el != nil {
        tuple := AnyValToType[[]any]("PACKED_IF_STMT.el", el)
        elseBranch = tuple[1]
    }

    if len(armList) == 0 {
        if elseBranch != nil {
            if eb, ok := elseBranch.(ir.Block); ok {
                return ir.IfStmt{
                    Cond: ir.Literal{Kind: ir.LITERAL_BOOL, Pos: currentPosition(c)},
                    Then: eb,
                    Pos:  currentPosition(c),
                }, nil
            }
        }
        return nil, fmt.Errorf("packed if requires at least one arm")
    }

    var currentElse any = elseBranch
    for i := len(armList) - 1; i >= 0; i-- {
        currentElse = ir.IfStmt{
            Cond: armList[i].cond,
            Then: armList[i].body,
            Else: currentElse,
            Pos:  armList[i].pos,
        }
    }

    return currentElse.(ir.IfStmt), nil
}

STANDARD_IF_STMT <- KW_IF _ cond:EXPR _ then:BLOCK el:(_ ELSE_BRANCH)? {
    var else_branch any
    if el != nil {
        else_branch = AnyValToType[[]any]("STANDARD_IF_STMT.else", el)[1]
    }

    return ir.IfStmt{
        Cond: AnyValToType[ir.Expr]("STANDARD_IF_STMT.cond", cond),
        Then: AnyValToType[ir.Block]("STANDARD_IF_STMT.then", then),
        Else: else_branch,
        Pos: currentPosition(c),
    }, nil
}

WHILE_STMT <- KW_WHILE _ cond:EXPR _ body:BLOCK {
    return ir.WhileStmt{
        Cond: AnyValToType[ir.Expr]("WHILE_STMT.cond", cond),
        Body: AnyValToType[ir.Block]("WHILE_STMT.body", body),
        Pos: currentPosition(c),
    }, nil
}

LOOP_WHILE_TAIL <- _ KW_WHILE _ ":" !":" _ "[" _ cond:EXPR _ "]" {
    return cond, nil
}

LOOP_STMT <- KW_LOOP _ body:BLOCK whilePart:LOOP_WHILE_TAIL? {
    bodyBlock := AnyValToType[ir.Block]("LOOP_STMT.body", body)
    if whilePart == nil {
        return ir.WhileStmt{
            Cond: ir.Literal{
                Kind:  ir.LITERAL_BOOL,
                Value: true,
                Pos:   currentPosition(c),
            },
            Body: bodyBlock,
            Pos:  currentPosition(c),
        }, nil
    }

    condExpr := AnyValToType[ir.Expr]("LOOP_STMT.cond", whilePart)

    return ir.DoWhileStmt{
        Body: bodyBlock,
        Cond: condExpr,
        Pos:  currentPosition(c),
    }, nil
}

FOR_STMT <- KW_FOR _ varName:IDENTIFIER _ KW_IN _ iter:EXPR _ body:BLOCK {
    return ir.ForStmt{
        VarName: string(AnyValToType[[]uint8]("FOR_STMT.var", varName)),
        Iter:    AnyValToType[ir.Expr]("FOR_STMT.iter", iter),
        Body:    AnyValToType[ir.Block]("FOR_STMT.body", body),
        Pos:     currentPosition(c),
    }, nil
}

DROP_STMT <- KW_DROP _ expr:EXPR {
    return ir.DropStmt{
        Expr: AnyValToType[ir.Expr]("DROP_STMT.expr", expr),
        Pos: currentPosition(c),
    }, nil
}

ASSIGN_STMT <- target:UNARY_EXPR _ "=" !"=" _ val:EXPR {
    return ir.AssignStmt{
        Target: AnyValToType[ir.Expr]("ASSIGN_STMT.target", target),
        Value:  AnyValToType[ir.Expr]("ASSIGN_STMT.val", val),
        Pos:    currentPosition(c),
    }, nil
}

STMT <- BIND_DEC / RETURN_STMT / BREAK_STMT / DROP_STMT / IF_STMT / WHILE_STMT / LOOP_STMT / FOR_STMT / LABEL_DEC / ASSIGN_STMT / EXPR

BLOCK <- "{" _ stmts:(_ STMT)* _ "}" {
    var stmt_list []any = []any{}
    if stmts != nil {
        raw_list := AnyValToType[[]any]("BLOCK.stmts", stmts)
        for _, tuple := range raw_list {
            st := AnyValToType[[]any]("BLOCK.tuple", tuple)[1]
            stmt_list = append(stmt_list, st)
        }
    }
    return ir.Block{
        Stmts: stmt_list,
        Pos: currentPosition(c),
    }, nil
}

LABELABLE <- BLOCK / IF_STMT / WHILE_STMT / LOOP_STMT / FOR_STMT

LABEL_DEC <- name:LABEL_IDENT _ ":" !":" _ body:LABELABLE {
    var blk ir.Block
    if b, ok := body.(ir.Block); ok {
        blk = b
    } else {
        blk = ir.Block{
            Stmts: []any{body},
            Pos: currentPosition(c),
        }
    }
    return ir.LabelDec{
        Name: string(AnyValToType[[]uint8]("LABEL_DEC.name", name)),
        Body: blk,
        Pos: currentPosition(c),
    }, nil
}

FN_DEC <- 
    pub:(KW_PUB _)?
    KW_FN 
    _ 
    name:FN_NAME 
    _ 
    "(" 
    _ 
    params:FN_PARAM_LIST? 
    _ 
    ")" 
    ret:(_ TYPE_REF)? 
    _ 
    body:BLOCK {
        var fn_params []ir.FnParam = []ir.FnParam{}
        if params != nil {
            fn_params = AnyValToType[[]ir.FnParam]("FN_DEC.params", params)
        }

        var return_type *ir.TYPE_REF
        if ret != nil {
            r := AnyValToType[[]any]("FN_DEC.ret", ret)[1]
            t := AnyValToType[ir.TYPE_REF]("FN_DEC.ret_type", r)
            return_type = &t
        }

        return ir.FN_DEC{
            Pos: currentPosition(c),
            IsPublic: pub != nil,
            Name: AnyValToType[string]("FN_DEC.name", name),
            Params: fn_params,
            ReturnType: return_type,
            Body: AnyValToType[ir.Block]("FN_DEC.body", body),
        }, nil
    }

TYPE_PARAM_ITEM <- id:IDENTIFIER (_ "where" ![a-zA-Z0-9_] _ BLOCK)? {
    return string(AnyValToType[[]uint8]("TYPE_PARAM_ITEM.id", id)), nil
}

TYPE_PARAMS <- "<" _ first:TYPE_PARAM_ITEM rest:(_ "," _ TYPE_PARAM_ITEM)* _ ">" {
    res := []string{AnyValToType[string]("TYPE_PARAMS.first", first)}
    if restSlice, ok := rest.([]any); ok {
        for _, item := range restSlice {
            tuple := AnyValToType[[]any]("TYPE_PARAMS.tuple", item)
            res = append(res, AnyValToType[string]("TYPE_PARAMS.item", tuple[3]))
        }
    }
    return res, nil
}

STRUCT_FIELD <- "."? name:IDENTIFIER (_ ":" _ / _SPACE+) ftype:TYPE_REF (_ ",")? {
    return ir.StructField{
        Name: string(AnyValToType[[]uint8]("STRUCT_FIELD.name", name)),
        Type: AnyValToType[ir.TYPE_REF]("STRUCT_FIELD.ftype", ftype),
        Pos:  currentPosition(c),
    }, nil
}

STRUCT_BODY <- "{" members:(_ (FN_DEC / STRUCT_FIELD))* _ "}" {
    var fields []ir.StructField
    var methods []ir.FN_DEC
    if rawSlice, ok := members.([]any); ok {
        for _, item := range rawSlice {
            tuple := AnyValToType[[]any]("STRUCT_BODY.tuple", item)
            switch m := tuple[1].(type) {
            case ir.StructField:
                fields = append(fields, m)
            case ir.FN_DEC:
                methods = append(methods, m)
            }
        }
    }
    return ir.TYPE_DEC{
        Kind:    ir.TYPE_DEC_STRUCT,
        Fields:  fields,
        Methods: methods,
        Pos:     currentPosition(c),
    }, nil
}

TRAIT_SIG_FN <- KW_FN _ name:FN_NAME _ "(" _ params:FN_PARAM_LIST? _ ")" ret:(_INLINE_WS TYPE_REF)? (_ ",")? {
    var fn_params []ir.FnParam
    if params != nil {
        fn_params = AnyValToType[[]ir.FnParam]("TRAIT_SIG_FN.params", params)
    }
    var return_type *ir.TYPE_REF
    if ret != nil {
        r := AnyValToType[[]any]("TRAIT_SIG_FN.ret", ret)[1]
        t := AnyValToType[ir.TYPE_REF]("TRAIT_SIG_FN.ret_type", r)
        return_type = &t
    }
    return ir.TraitMethodSig{
        Name:       AnyValToType[string]("TRAIT_SIG_FN.name", name),
        Params:     fn_params,
        ReturnType: return_type,
        Pos:        currentPosition(c),
    }, nil
}

TRAIT_SIG_FIELD <- name:IDENTIFIER (_ ":" _ / _SPACE+) fnType:TYPE_FN (_ ",")? {
    tf := AnyValToType[ir.TypeFn]("TRAIT_SIG_FIELD.fnType", fnType)
    return ir.TraitMethodSig{
        Name:       string(AnyValToType[[]uint8]("TRAIT_SIG_FIELD.name", name)),
        Params:     tf.Params,
        ReturnType: tf.ReturnType,
        Pos:        currentPosition(c),
    }, nil
}

TRAIT_METHOD_SIG <- TRAIT_SIG_FN / TRAIT_SIG_FIELD

TRAIT_BODY <- "{" sigs:(_ TRAIT_METHOD_SIG)* _ "}" {
    var list []ir.TraitMethodSig
    if rawSlice, ok := sigs.([]any); ok {
        for _, item := range rawSlice {
            tuple := AnyValToType[[]any]("TRAIT_BODY.tuple", item)
            list = append(list, AnyValToType[ir.TraitMethodSig]("TRAIT_BODY.sig", tuple[1]))
        }
    }
    return ir.TYPE_DEC{
        Kind:      ir.TYPE_DEC_TRAIT,
        TraitSigs: list,
        Pos:       currentPosition(c),
    }, nil
}

TYPE_RHS_STRUCT <- KW_STRUCT _ body:STRUCT_BODY {
    return body, nil
}

TYPE_RHS_TRAIT <- KW_TRAIT _ body:TRAIT_BODY {
    return body, nil
}

TYPE_DEC <-
    pub:(KW_PUB _)?
    KW_TYPE
    _
    name:IDENTIFIER
    tparams:TYPE_PARAMS?
    _
    "="
    _
    rhs:(TYPE_RHS_STRUCT / TYPE_RHS_TRAIT / STRUCT_BODY / TYPE_REF) {
        var tp []string
        if tparams != nil {
            tp = AnyValToType[[]string]("TYPE_DEC.tparams", tparams)
        }
        typeName := string(AnyValToType[[]uint8]("TYPE_DEC.name", name))
        switch v := rhs.(type) {
        case ir.TYPE_DEC:
            v.Name = typeName
            v.IsPublic = pub != nil
            v.TypeParams = tp
            v.Pos = currentPosition(c)
            return v, nil
        case ir.TYPE_REF:
            alias := v
            return ir.TYPE_DEC{
                Name:       typeName,
                IsPublic:   pub != nil,
                TypeParams: tp,
                Kind:       ir.TYPE_DEC_ALIAS,
                AliasType:  &alias,
                Pos:        currentPosition(c),
            }, nil
        default:
            gpanic("TYPE_DEC", fmt.Sprintf("unexpected rhs %T", rhs))
            return nil, nil
        }
    }

IMPL_TRAIT_DEC <-
    KW_IMPL
    _
    traitName:IDENTIFIER
    traitArgs:TYPE_REF_ARGS?
    _
    (KW_ON / KW_FOR)
    _
    target:TYPE_REF
    _
    "{"
    methods:(_ FN_DEC)*
    _
    "}" {
        var targs []ir.TYPE_REF
        if traitArgs != nil {
            targs = AnySliceToSliceOfType[ir.TYPE_REF]("IMPL_TRAIT_DEC.traitArgs", traitArgs)
        }
        var fnList []ir.FN_DEC
        if rawSlice, ok := methods.([]any); ok {
            for _, item := range rawSlice {
                tuple := AnyValToType[[]any]("IMPL_TRAIT_DEC.tuple", item)
                fnList = append(fnList, AnyValToType[ir.FN_DEC]("IMPL_TRAIT_DEC.fn", tuple[1]))
            }
        }
        return ir.IMPL_DEC{
            TraitName:  string(AnyValToType[[]uint8]("IMPL_TRAIT_DEC.traitName", traitName)),
            TraitArgs:  targs,
            TargetType: AnyValToType[ir.TYPE_REF]("IMPL_TRAIT_DEC.target", target),
            Methods:    fnList,
            Pos:        currentPosition(c),
        }, nil
    }

IMPL_INHERENT_DEC <-
    KW_IMPL
    _
    target:TYPE_REF
    _
    "{"
    methods:(_ FN_DEC)*
    _
    "}" {
        var fnList []ir.FN_DEC
        if rawSlice, ok := methods.([]any); ok {
            for _, item := range rawSlice {
                tuple := AnyValToType[[]any]("IMPL_INHERENT_DEC.tuple", item)
                fnList = append(fnList, AnyValToType[ir.FN_DEC]("IMPL_INHERENT_DEC.fn", tuple[1]))
            }
        }
        return ir.IMPL_DEC{
            TraitName:  "",
            TargetType: AnyValToType[ir.TYPE_REF]("IMPL_INHERENT_DEC.target", target),
            Methods:    fnList,
            Pos:        currentPosition(c),
        }, nil
    }

IMPL_DEC <- IMPL_TRAIT_DEC / IMPL_INHERENT_DEC
