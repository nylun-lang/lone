{
    package parser

    import (
        ir "lone/pkg/ast"
        "fmt"
        "strconv"
    )

    func currentPosition(c *current) ir.Position {
        return ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
            Offset: c.pos.offset,
        }
    }

    func gpanic(rule string, text string) {
        panic(fmt.Sprintf("[Grammar Error] Rule=%s; %s", rule, text))
    }

    func printError(p ir.Position, rawInput string, msg string) {
        content := "[Error]: internal parse error\n%s\n> %d:%d | %s"
        fmt.Printf(content, msg, p.Line, p.Col, rawInput)
    }

    func AnyValToType[T any](ref string, v any) T {
        cast, ok := v.(T)
        if !ok {
            panic(fmt.Sprintf("[AnyValToType][%s] expected %T, got %T", ref, *new(T), v))
        }
        return cast
    }

    func AnySliceToSliceOfType[T any](ref string, v any) []T {
        
        s, ok := v.([]any)
        if !ok {
            panic(fmt.Sprintf("[AnySliceToSliceOfType][%s]\nError: cannot cast  slice of type %T as []any", ref, v))
        }

        out := make([]T, len(s))

        for i, e := range s {
            out[i], ok = e.(T)
            if !ok {
                panic(fmt.Sprintf("[AnySliceToSliceOfType][%s]\nError: cannot cast curr el of type %T as %T", ref, e, *new(T)))
            }
        }

        return out
    }

    func AnySliceToString(ref string, chars any) string {
        var b strings.Builder
        chars_list, ok := chars.([]any)
        
        if !ok {
            panic(fmt.Sprintf("[AnySliceToString][%s] cannot cast chars of type %T as []any", ref, chars))
        }
        
        for _, c := range chars_list {
            curr, ok := c.([]byte)
            if !ok {
                panic(fmt.Sprintf("[AnySliceToString][%s] cannot cast curr of type %T as string", ref, curr))
            }
            b.WriteString(string(curr))
        }
        
        return b.String()
    }

    func FoldBinaryExpr(ref string, c *current, head any, rest any) ir.Expr {
        
        curr := AnyValToType[ir.Expr](
            fmt.Sprintf("%s.left", ref),
            head,
        )

        tail := AnyValToType[[]any](
            fmt.Sprintf("%s.tail", ref),
            rest,
        )

        if len(tail) == 0 {
            return curr
        }

        for _, part := range tail {
            tuple := AnyValToType[[]any](
                fmt.Sprintf("%s.tuple", ref),
                part,
            )

            opBytes := AnyValToType[[]byte](fmt.Sprintf("%s.op", ref), tuple[1])
            op := ir.BinaryOp(string(opBytes))

            right := AnyValToType[ir.Expr](
                fmt.Sprintf("%s.right", ref),
                tuple[3],
            )

            curr = ir.BinaryExpr{
                Op: op,
                Left: curr,
                Right: right,
                Pos: currentPosition(c),
            }
        }

        return curr
    }
}

PROGRAM <- decls:(_ TOP_LEVEL)* _ EOF {
    return decls, nil
}

EOF <- !.

TOP_LEVEL <- BIND_DEC / FN_DEC / IF_STMT / WHILE_STMT / LABEL_DEC / DROP_STMT


KW_FN <- "fn" ![a-zA-Z0-9_]
KW_VAR <- "var" ![a-zA-Z0-9_]
KW_TYPE <- "type" ![a-zA-Z0-9_]
KW_NONE <- "none" ![a-zA-Z0-9_]
KW_BOOL <- ("true" / "false") ![a-zA-Z0-9_]
KW_READONLY <- "ro" ![a-zA-Z0-9_]
KW_COMPTIME <- "comptime" ![a-zA-Z0-9_]
KW_RETURN <- "return" ![a-zA-Z0-9_]
KW_BREAK <- "break" ![a-zA-Z0-9_]
KW_IF <- "if" ![a-zA-Z0-9_]
KW_ELSE <- "else" ![a-zA-Z0-9_]
KW_WHILE <- "while" ![a-zA-Z0-9_]
KW_DROP <- "drop" ![a-zA-Z0-9_]

KEYWORD <- 
    KW_VAR /
    KW_TYPE /
    KW_FN /
    KW_BOOL /
    KW_NONE /
    KW_READONLY /
    KW_COMPTIME /
    KW_RETURN /
    KW_BREAK /
    KW_IF /
    KW_ELSE /
    KW_WHILE /
    KW_DROP

FN_NAME <- "#"? IDENTIFIER {
    return string(c.text), nil
}

IDENTIFIER <- !KEYWORD [a-zA-Z_] [a-zA-Z0-9_]* {
    return c.text, nil
}

_EOL <- "\r\n" / "\n"
_SPACE <- [ \t]
_INLINE_COMMENT     <- "--" ("fa:" IDENTIFIER)? (!EOL .)*
_MULTI_LINE_COMMENT <- "---" ("fa:" IDENTIFIER)? (!"---" .)*
_COMMENT <- (_MULTI_LINE_COMMENT / _INLINE_COMMENT)
_INLINE_WS <- (_SPACE / _INLINE_COMMENT)*

_ <- (_SPACE / _EOL / _COMMENT)*




Digits <- [0-9]+ ("_" [0-9]+)*

Float <- Digits "." Digits {   
    val, err := strconv.ParseFloat(string(c.text), 64)

    if err != nil {
        gpanic("Float", "cannot parse c.text as float")
    }

    return ir.Literal{
        Kind: ir.LITERAL_FLOAT,
        Value: val,
        Pos: currentPosition(c),
    }, nil
}

Int <- Digits {
    val, err := strconv.Atoi(string(c.text))

    if err != nil {
        gpanic("Int", "cannot parse c.text as integer")
    }

    return ir.Literal{
        Kind: ir.LITERAL_INT,
        Value: val,
        Pos: currentPosition(c),
    }, nil
}

NUMBER <- Float / Int

BOOL <- KW_BOOL {
    val := false
    txt := string(c.text)

    if txt == "true" {
        val = true
    }

    return ir.Literal{
        Kind: ir.LITERAL_BOOL,
        Value: val, 
        Pos: currentPosition(c),
    }, nil
}

NONE <- KW_NONE {
    return ir.Literal{
        Kind: ir.LITERAL_NONE,
        Value: nil,
        Pos: ir.Position{
            Col: c.pos.col,
            Line: c.pos.line,
        },
    }, nil
}

Escape <- '\\' cc:(
      '"'
    / '\\'
    / 'n'
    / 'r'
    / 't'
) {
    var b byte
    if slice, ok := cc.([]byte); ok && len(slice) > 0 {
        b = slice[0]
    } else if bVal, ok := cc.(byte); ok {
        b = bVal
    } else {
        b = AnyValToType[byte]("Escape.c", cc)
    }
    switch b {
    case 'n':
        return []byte{'\n'}, nil
    case 'r':
        return []byte{'\r'}, nil
    case 't':
        return []byte{'\t'}, nil
    case '"':
        return []byte{'"'}, nil
    case '\\':
        return []byte{'\\'}, nil
    }
    return nil, fmt.Errorf("invalid escape")
}

Inline_normal_char <- cc:(!('"' / _EOL ) .) {
    return AnyValToType[[]any]("Normal_char.c", cc)[1], nil
}

Inline_char <- Escape / Inline_normal_char

STRING <- '"' content:Inline_char* '"' {
    var txt strings.Builder
    
    for _, b := range AnySliceToSliceOfType[[]byte]("STRING.s", content) {
        char := string(b)
        txt.WriteString(char)
    }

    return ir.Literal{
        Kind: ir.LITERAL_STRING,
        Value: txt.String(),
        Pos: currentPosition(c),
    }, nil
}

LITERAL <- NUMBER / BOOL / NONE / STRING


NAME_REF <- "#"? IDENTIFIER {
    return ir.NameRef{
        Name: string(c.text),
        Pos: currentPosition(c),
    }, nil
}

Field_val_list 
    <- first:Field_val_assign 
       list:(_ "," _ Field_val_assign)* 
       {
        
        fields := []ir.FieldAssign{
            AnyValToType[ir.FieldAssign]("Field_val_list.first", first),
        }

        for _,r := range AnyValToType[[]any]("Field_val_list.l", list) {
            tuple := AnyValToType[[]any]("Field_val_list.tuple", r)
            fields = append(
                fields, 
                AnyValToType[ir.FieldAssign]("Field_val_list.fields", tuple[3]),
            )
        }

        return fields, nil
    }

Field_val_assign 
    <- "." field_name:IDENTIFIER":" _ field_val:EXPR {
        name := AnySliceToString("Field_val_assign.name", []any{field_name})
        expr := AnyValToType[ir.Expr]("Field_val_assign.expr", field_val)

        return ir.FieldAssign{
            Name: name,
            Expr: expr,
        }, nil
    }

OBJECT_LITERAL 
    <- "{" _ f:Field_val_list _ "}" {
        fields := AnyValToType[[]ir.FieldAssign]("ObjectLiteral.fields", f)
        return ir.ObjectLiteral{
            Fields: fields,
            Pos: currentPosition(c),
        }, nil
    }

EXPR_LIST
<- first:EXPR rest:("," _ EXPR)* {
    args := []ir.Expr{
        AnyValToType[ir.Expr]("EXPR_LIST.first", first),
    }

    for _, part := range AnyValToType[[]any]("EXPR_LIST.rest", rest) {
        tuple := AnyValToType[[]any]("EXPR_LIST.part", part)

        args = append(
            args,
            AnyValToType[ir.Expr]("EXPR_LIST.arg", tuple[2]),
        )
    }

    return args, nil
}

LIST_LITERAL 
    <- "{" _ exprs:EXPR_LIST _ "}" {
        content := AnyValToType[[]ir.Expr]("ListLiteral.exprs", exprs)
        return ir.ListLiteral{
            Content: content,
            Pos: currentPosition(c),
        }, nil
    }

PRIMARY_EXPR <- 
    LABEL_DEC
    / IF_STMT
    / WHILE_STMT
    / BREAK_STMT
    / DROP_STMT
    / LITERAL 
    / NAME_REF 
    / OBJECT_LITERAL
    / LIST_LITERAL
    / "(" _ expr:EXPR _ ")" { return expr, nil }

Call
<- "(" _ args:EXPR_LIST? _ ")" {
    call_args := []ir.Expr{}

    if args != nil {
        call_args = AnyValToType[[]ir.Expr]("Call.args", args)
    }

    return ir.SuffixCall{
        Args: call_args,
        Pos: currentPosition(c),
    }, nil
}

Member_access <- "." name:IDENTIFIER {
    return ir.SuffixMemberAccess{
        Name: string(AnyValToType[[]byte]("Member_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Namespace_access <- ":" name:IDENTIFIER {
    return ir.SuffixNamespaceAccess{
        Name: string(AnyValToType[[]byte]("Namespace_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Associated_access <- "::" name:IDENTIFIER {
    return ir.SuffixAssociatedAccess{
        Name: string(AnyValToType[[]byte]("Associated_access.name", name)),
        Pos: currentPosition(c),
    }, nil
}

Call_type_init <- "::" expr:Call {
    call := ir.SuffixCallTypeInit(AnyValToType[ir.SuffixCall]("Call_type_init.call", expr))
    return call, nil
}

Call_type_make <- "::" data:(OBJECT_LITERAL / LIST_LITERAL) {
    _, is_obj := data.(ir.ObjectLiteral)
    call := ir.SuffixCallTypeMake{
        Arg: data,
        Pos: currentPosition(c),
    }
    
    if is_obj {
        call.Kind = ir.CALL_TYPE_MAKE_OBJ
    } else {
        call.Kind = ir.CALL_TYPE_MAKE_LIST
    }

    return call, nil
}

Postfix_suffix <- 
    Member_access
    / Namespace_access
    / Associated_access
    / Call
    / Call_type_init
    / Call_type_make


POSTFIX_EXPR
<- base:PRIMARY_EXPR suffix:Postfix_suffix* {
    return ir.PostFixExpr{
        Base: AnyValToType[ir.Expr]("POSTFIX_EXPR.base", base),
        Suffix: AnySliceToSliceOfType[ir.Suffix]("POSTFIX_EXPR.suffix", suffix),
        Pos: currentPosition(c),
    }, nil
}

UNARY_OP
<- "-"
/ "+"
/ "!"
/ "&"
/ "*"

UNARY_EXPR
<- op:UNARY_OP _ expr:UNARY_EXPR {
    return ir.UnaryExpr{
        Op:   ir.UnaryOp(string(AnyValToType[[]byte]("UNARY_EXPR.op", op))),
        Expr: AnyValToType[ir.Expr]("UNARY_EXPR.expr", expr),
        Pos:  currentPosition(c),
    }, nil
}
/ POSTFIX_EXPR

MUL_BINARY_EXPR 
<- left:UNARY_EXPR right:(_ ("*" / "/") _ UNARY_EXPR)* {
    expr := FoldBinaryExpr("MUL_BINARY_EXPR", c, left, right)
    return expr, nil
} / UNARY_EXPR


ADD_BINARY_EXPR 
<- left:MUL_BINARY_EXPR right:(_ ("+" / "-") _ MUL_BINARY_EXPR)* {
    expr := FoldBinaryExpr("ADD_BINARY_EXPR", c, left, right)
    return expr, nil
} 

Comparision_Op 
<- ">="
/  "<="
/  ">"
/  "<"

COMPARISION_BINARY_EXPR 
<- left:ADD_BINARY_EXPR right:(_ Comparision_Op _ ADD_BINARY_EXPR)* {
    expr := FoldBinaryExpr("COMPARISION_BINARY_EXPR", c, left, right)
    return expr, nil
}

Equality_Op
<- "=="
/  "!="

EQUALITY_BINARY_EXPR 
<- left:COMPARISION_BINARY_EXPR right:(_ Equality_Op _ COMPARISION_BINARY_EXPR)* {
    expr := FoldBinaryExpr("EQUALITY_BINARY_EXPR", c, left, right)
    return expr, nil
}

BITWISE_OR_BINARY_EXPR 
<- left:EQUALITY_BINARY_EXPR right:(_ "|" _ EQUALITY_BINARY_EXPR)* {
    expr := FoldBinaryExpr("BITWISE_OR_BINARY_EXPR", c, left, right)
    return expr, nil
}

BITWISE_XOR_BINARY_EXPR 
<- left:BITWISE_OR_BINARY_EXPR right:(_ "^" _ BITWISE_OR_BINARY_EXPR)* {
    expr := FoldBinaryExpr("BITWISE_XOR_BINARY_EXPR", c, left, right)
    return expr, nil
}

BITWISE_AND_BINARY_EXPR 
<- left:BITWISE_OR_BINARY_EXPR right:(_ "&" _ BITWISE_OR_BINARY_EXPR)* {
    expr := FoldBinaryExpr("BITWISE_AND_BINARY_EXPR", c, left, right)
    return expr, nil
}

LOGICAL_AND_BINARY_EXPR 
<- left:BITWISE_AND_BINARY_EXPR right:(_ "and" _ BITWISE_AND_BINARY_EXPR)* {
    expr := FoldBinaryExpr("LOGICAL_AND_BINARY_EXPR", c, left, right)
    return expr, nil
}

LOGICAL_OR_BINARY_EXPR 
<- left:LOGICAL_AND_BINARY_EXPR right:(_ "or" _ LOGICAL_AND_BINARY_EXPR)* {
    expr := FoldBinaryExpr("LOGICAL_OR_BINARY_EXPR", c, left, right)
    return expr, nil
}

EXPR <- LOGICAL_OR_BINARY_EXPR

TYPE_REF_ARGS <- 
    "<"
    _
    first:TYPE_REF
    rest:(_ "," _ TYPE_REF)*
    _
    ">" {
        result := []any{first}
        rest_list := AnyValToType[[]any]("TYPE_REF_ARGS.rest_list", rest)
        for _, tuple := range(rest_list) {
            arg := AnyValToType[[]any]("TYPE_REF_ARGS.arg", tuple)[3]
            result = append(result, arg)
        }
        return result, nil
    }

TYPE_BASE <- 
    name:IDENTIFIER
    args:TYPE_REF_ARGS? {
        var type_args []ir.TYPE_REF = []ir.TYPE_REF{}
        if args != nil {
            type_args = AnySliceToSliceOfType[ir.TYPE_REF]("TYPE_BASE.type_args", args)
        }

        return ir.TypeBase{
            Name: string(AnyValToType[[]uint8]("TYPE_BASE.name", name)),
            Args: type_args,
        }, nil
    }

TYPE_LIST <- 
    "[" 
    _ 
    size:EXPR?
    _
    "]" 
    _ 
    elem:TYPE_REF {
        var list_size ir.Expr = ir.Literal{
            Kind: ir.LITERAL_DYNAMIC_SIZE,
            Pos: currentPosition(c),
        }

        if size != nil {
            list_size = AnyValToType[ir.Expr]("TYPE_LIST.size", size)
        }

        itemType := AnyValToType[ir.TYPE_REF]("TYPE_LIST.elem", elem)
        return ir.TypeList{
            Size: list_size,
            ItemType: itemType,
        }, nil
    }

FN_PARAM <- 
    name:(IDENTIFIER _ ":" _)? 
    ptype:TYPE_REF {
        param_name := ""
        if name != nil {
            n := AnyValToType[[]any]("FN_PARAM.name", name)[0]
            param_name = string(AnyValToType[[]uint8]("FN_PARAM.name_str", n))
        }
        param_type := AnyValToType[ir.TYPE_REF]("FN_PARAM.ptype", ptype)
        return ir.FnParam{
            Name: param_name,
            Type: param_type,
        }, nil
    }

FN_PARAM_LIST <- 
    first:FN_PARAM 
    rest:(_ "," _ FN_PARAM)* 
    (_ ",")? {
        result := []ir.FnParam{
            AnyValToType[ir.FnParam]("FN_PARAM_LIST.first", first),
        }
        if rest != nil {
            rest_list := AnyValToType[[]any]("FN_PARAM_LIST.rest_list", rest)
            for _, tuple := range rest_list {
                p := AnyValToType[[]any]("FN_PARAM_LIST.tuple", tuple)[3]
                result = append(result, AnyValToType[ir.FnParam]("FN_PARAM_LIST.p", p))
            }
        }
        return result, nil
    }

TYPE_FN <- 
    KW_FN 
    _ 
    "(" 
    _ 
    params:FN_PARAM_LIST? 
    _ 
    ")" 
    ret:(_ TYPE_REF)? {
        var fn_params []ir.FnParam = []ir.FnParam{}
        if params != nil {
            fn_params = AnyValToType[[]ir.FnParam]("TYPE_FN.params", params)
        }

        var return_type *ir.TYPE_REF
        if ret != nil {
            r := AnyValToType[[]any]("TYPE_FN.ret", ret)[1]
            t := AnyValToType[ir.TYPE_REF]("TYPE_FN.ret_type", r)
            return_type = &t
        }

        return ir.TypeFn{
            Params: fn_params,
            ReturnType: return_type,
        }, nil
    }

TYPE_ACTUAL <- TYPE_FN / TYPE_LIST / TYPE_BASE

TYPE_REF <- 
    is_comptime:KW_COMPTIME?
    _
    is_readonly:KW_READONLY? 
    _ 
    is_optional:"?"? 
    _
    actual:TYPE_ACTUAL {
        constrain := ir.TypeConstrain{
            Comptime: is_comptime != nil,
            ReadOnly: is_readonly != nil,
            Optional: is_optional != nil,
        }

        var kind ir.TypeRefKind
        switch actual.(type) {
        case ir.TypeBase:
            kind = ir.TYPE_BASE
        case ir.TypeList:
            kind = ir.TYPE_LIST
        case ir.TypeFn:
            kind = ir.TYPE_FN
        default:
            gpanic("TYPE_REF", fmt.Sprintf("unexpected type %T", actual))
        }

        return ir.TYPE_REF{
            Pos: currentPosition(c),
            Kind: kind,
            Constrain: constrain,
            Value: actual,
        }, nil
    }

BIND_DEC <- 
    KW_VAR 
    _ 
    name:IDENTIFIER 
    vtype:(":" _ TYPE_REF)?
    value:(_ "=" _ EXPR)? {

    pos := currentPosition(c)
    var resolved ir.Expr
    
    if value != nil {
        val := AnyValToType[[]any]("BIND_DEC.resolved", value)[3]
        resolved = AnyValToType[ir.Expr]("BIND_DEC.resolved", val)
    } else {
        resolved = ir.Literal{ Kind: ir.LITERAL_UNINITIALIZED }
    }

    var resolved_type ir.TYPE_REF
    if vtype != nil {
        extracted_type := AnyValToType[[]any]("BIND_DEC.resolved_type", vtype)[2]
        resolved_type = AnyValToType[ir.TYPE_REF]("BIND_DEC.resolved_type", extracted_type)
    } else {
        resolved_type = ir.TYPE_REF{
            Kind: ir.TYPE_BASE,
            Pos: currentPosition(c),
            Constrain: ir.TypeConstrain{},
            Value: ir.TypeBase{
                Name: "infer",
                Args: []ir.TYPE_REF{},
            },
        }
    }

    return ir.BIND_DEC{
        Pos: pos,
        Name: string(AnyValToType[[]uint8]("BIND_DEC.name", name)),
        Value: resolved,
        Type: resolved_type,
    }, nil
}

RETURN_STMT <- KW_RETURN expr:(_INLINE_WS EXPR)? {
    var val ir.Expr
    if expr != nil {
        val = AnyValToType[ir.Expr]("RETURN_STMT.val", AnyValToType[[]any]("RETURN_STMT.tuple", expr)[1])
    }
    return ir.ReturnStmt{
        Value: val,
        Pos: currentPosition(c),
    }, nil
}

BREAK_LABEL <- id:IDENTIFIER _INLINE_WS ":" !":" {
    return string(AnyValToType[[]uint8]("BREAK_LABEL.id", id)), nil
}

BREAK_STMT <- KW_BREAK label:(_INLINE_WS BREAK_LABEL)? val:(_INLINE_WS EXPR)? {
    var label_name string
    if label != nil {
        label_name = AnyValToType[string]("BREAK_STMT.label", AnyValToType[[]any]("BREAK_STMT.label_tuple", label)[1])
    }

    var break_val ir.Expr
    if val != nil {
        break_val = AnyValToType[ir.Expr]("BREAK_STMT.val", AnyValToType[[]any]("BREAK_STMT.val_tuple", val)[1])
    }

    return ir.BreakStmt{
        Label: label_name,
        Value: break_val,
        Pos: currentPosition(c),
    }, nil
}

ELSE_BRANCH <- KW_ELSE _ branch:(IF_STMT / BLOCK) {
    return branch, nil
}

IF_STMT <- KW_IF _ cond:EXPR _ then:BLOCK el:(_ ELSE_BRANCH)? {
    var else_branch any
    if el != nil {
        else_branch = AnyValToType[[]any]("IF_STMT.else", el)[1]
    }

    return ir.IfStmt{
        Cond: AnyValToType[ir.Expr]("IF_STMT.cond", cond),
        Then: AnyValToType[ir.Block]("IF_STMT.then", then),
        Else: else_branch,
        Pos: currentPosition(c),
    }, nil
}

WHILE_STMT <- KW_WHILE _ cond:EXPR _ body:BLOCK {
    return ir.WhileStmt{
        Cond: AnyValToType[ir.Expr]("WHILE_STMT.cond", cond),
        Body: AnyValToType[ir.Block]("WHILE_STMT.body", body),
        Pos: currentPosition(c),
    }, nil
}

DROP_STMT <- KW_DROP _ expr:EXPR {
    return ir.DropStmt{
        Expr: AnyValToType[ir.Expr]("DROP_STMT.expr", expr),
        Pos: currentPosition(c),
    }, nil
}

STMT <- BIND_DEC / RETURN_STMT / BREAK_STMT / DROP_STMT / IF_STMT / WHILE_STMT / EXPR

BLOCK <- "{" _ stmts:(_ STMT)* _ "}" {
    var stmt_list []any = []any{}
    if stmts != nil {
        raw_list := AnyValToType[[]any]("BLOCK.stmts", stmts)
        for _, tuple := range raw_list {
            st := AnyValToType[[]any]("BLOCK.tuple", tuple)[1]
            stmt_list = append(stmt_list, st)
        }
    }
    return ir.Block{
        Stmts: stmt_list,
        Pos: currentPosition(c),
    }, nil
}

LABELABLE <- BLOCK / IF_STMT / WHILE_STMT

LABEL_DEC <- name:IDENTIFIER _ ":" !":" _ body:LABELABLE {
    var blk ir.Block
    if b, ok := body.(ir.Block); ok {
        blk = b
    } else {
        blk = ir.Block{
            Stmts: []any{body},
            Pos: currentPosition(c),
        }
    }
    return ir.LabelDec{
        Name: string(AnyValToType[[]uint8]("LABEL_DEC.name", name)),
        Body: blk,
        Pos: currentPosition(c),
    }, nil
}

FN_DEC <- 
    KW_FN 
    _ 
    name:FN_NAME 
    _ 
    "(" 
    _ 
    params:FN_PARAM_LIST? 
    _ 
    ")" 
    ret:(_ TYPE_REF)? 
    _ 
    body:BLOCK {
        var fn_params []ir.FnParam = []ir.FnParam{}
        if params != nil {
            fn_params = AnyValToType[[]ir.FnParam]("FN_DEC.params", params)
        }

        var return_type *ir.TYPE_REF
        if ret != nil {
            r := AnyValToType[[]any]("FN_DEC.ret", ret)[1]
            t := AnyValToType[ir.TYPE_REF]("FN_DEC.ret_type", r)
            return_type = &t
        }

        return ir.FN_DEC{
            Pos: currentPosition(c),
            Name: AnyValToType[string]("FN_DEC.name", name),
            Params: fn_params,
            ReturnType: return_type,
            Body: AnyValToType[ir.Block]("FN_DEC.body", body),
        }, nil
    }