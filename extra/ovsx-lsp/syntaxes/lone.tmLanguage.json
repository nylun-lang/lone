{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lone",
  "scopeName": "source.lone",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#intrinsics" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#function-declarations" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lone",
          "begin": "---",
          "end": "---"
        },
        {
          "name": "comment.line.double-dash.lone",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lone",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lone",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.lone",
          "match": "\\b[0-9]+(_[0-9]+)*\\.[0-9]+(_[0-9]+)*\\b"
        },
        {
          "name": "constant.numeric.integer.lone",
          "match": "\\b[0-9]+(_[0-9]+)*\\b"
        }
      ]
    },
    "intrinsics": {
      "patterns": [
        {
          "name": "support.function.builtin.lone",
          "match": "#[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.lone",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*:[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lone",
          "match": "\\b(if|else|while|loop|for|in|return|break|and|or)\\b"
        },
        {
          "name": "keyword.declaration.lone",
          "match": "\\b(fn|var|let|type|struct|trait|impl|drop|pub|import|from|as)\\b"
        },
        {
          "name": "keyword.other.lone",
          "match": "\\b(ro|comptime)\\b"
        },
        {
          "name": "constant.language.lone",
          "match": "\\b(true|false|none)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.lone",
          "match": "\\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64|int|bool|str|string|char|void|any|infer|ptr|ref)\\b"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.lone" },
            "2": { "name": "entity.name.function.lone" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.lone" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.lone",
          "match": "(&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.comparison.lone",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.lone",
          "match": "(:=|=)"
        },
        {
          "name": "keyword.operator.pointer.lone",
          "match": "(&raw|&|\\*)"
        },
        {
          "name": "keyword.operator.arithmetic.lone",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.lone",
          "match": "(::\\||::|:|\\?|->|=>)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.lone",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
