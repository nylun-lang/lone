-- Lone Standard Library: Pure-Lone Standard I/O (:std:io)
-- Built cleanly atop :std:sys without C dependencies or inline WebAssembly.

import .sys_write, .sys_read, .sys_random, .STDIN_FD, .STDOUT_FD, .STDERR_FD from :std:sys

-- Computes the UTF-8 byte length of a null-terminated string in linear memory.
pub fn str_len(s: str) i32 {
    var n: i32 = 0
    while s[n] != 0 {
        n = n + 1
    }
    return n
}

-- Stream writing contract.
pub type Writer = trait {
    fn write(self, msg: str) i32
}

-- Stream reading contract.
pub type Reader = trait {
    fn read(self, buf: ptr<u8>, max_len: i32) i32
}

-- Standard output stream handle (fd 1).
pub type Stdout = struct {
    fd: i32,

    pub fn new() Stdout {
        return Stdout::{ .fd: STDOUT_FD }
    }
}

-- Standard error stream handle (fd 2).
pub type Stderr = struct {
    fd: i32,

    pub fn new() Stderr {
        return Stderr::{ .fd: STDERR_FD }
    }
}

-- Standard input stream handle (fd 0).
pub type Stdin = struct {
    fd: i32,

    pub fn new() Stdin {
        return Stdin::{ .fd: STDIN_FD }
    }
}

impl Writer on Stdout {
    fn write(self, msg: str) i32 {
        return sys_write(self.fd, &raw msg[0], str_len(msg))
    }
}

impl Writer on Stderr {
    fn write(self, msg: str) i32 {
        return sys_write(self.fd, &raw msg[0], str_len(msg))
    }
}

impl Reader on Stdin {
    fn read(self, buf: ptr<u8>, max_len: i32) i32 {
        return sys_read(self.fd, buf, max_len)
    }
}

-- Writes `msg` to standard output without a trailing newline.
pub fn print(msg: str) void {
    var out = Stdout.new()
    drop out.write(msg)
}

-- Writes `msg` followed by a newline to standard output.
pub fn println(msg: str) void {
    var out = Stdout.new()
    drop out.write(msg)
    drop out.write("\n")
}

-- Writes `msg` to standard error without a trailing newline.
pub fn eprint(msg: str) void {
    var err = Stderr.new()
    drop err.write(msg)
}

-- Writes `msg` followed by a newline to standard error.
pub fn eprintln(msg: str) void {
    var err = Stderr.new()
    drop err.write(msg)
    drop err.write("\n")
}

-- Reads a single line from standard input (stripping trailing \r and \n),
-- promotes the resulting UTF-8 buffer to the managed heap store, and returns it as `str`.
pub fn read_line() str {
    var tmp: [1024]u8
    var len: i32 = 0
    var ch: u8 = 0
    var inp = Stdin.new()

    while len < 1023 {
        var n: i32 = inp.read(&raw ch, 1)
        if n <= 0 {
            break
        }
        if ch == 10 {
            break
        }
        if ch != 13 {
            tmp[len] = ch
            len = len + 1
        }
    }

    var out: ptr<u8> = #heap_alloc(len + 1)
    var i: i32 = 0
    while i < len {
        out[i] = tmp[i]
        i = i + 1
    }
    out[len] = 0
    return #ptr_to_str(out)
}

-- Converts an integer to a heap-allocated string.
pub fn int_to_str(n: i32) str {
    if n == 0 {
        return "0"
    }
    var is_neg = false
    var val: i32 = n
    if val < 0 {
        is_neg = true
        val = 0 - val
    }
    var digits: [16]u8
    var count: i32 = 0
    while val > 0 {
        var digit: i32 = val % 10
        digits[count] = digit + 48
        count = count + 1
        val = val / 10
    }
    var total_len: i32 = count
    if is_neg {
        total_len = count + 1
    }
    var out: ptr<u8> = #heap_alloc(total_len + 1)
    var out_idx: i32 = 0
    if is_neg {
        out[0] = 45
        out_idx = 1
    }
    var i: i32 = 0
    while i < count {
        out[out_idx + i] = digits[count - 1 - i]
        i = i + 1
    }
    out[total_len] = 0
    return #ptr_to_str(out)
}

-- Writes an integer to standard output without a trailing newline.
pub fn print_int(n: i32) void {
    print(int_to_str(n))
}

-- Writes an integer followed by a newline to standard output.
pub fn println_int(n: i32) void {
    println(int_to_str(n))
}

-- Parses an integer from a string, skipping leading whitespace and handling optional signs.
pub fn parse_int(s: str) i32 {
    var n: i32 = 0
    var i: i32 = 0
    var is_neg = false

    while s[i] == 32 or s[i] == 9 or s[i] == 10 or s[i] == 13 {
        i = i + 1
    }

    if s[i] == 45 {
        is_neg = true
        i = i + 1
    } else if s[i] == 43 {
        i = i + 1
    }

    while s[i] != 0 {
        var ch: u8 = s[i]
        if ch >= 48 and ch <= 57 {
            var digit: i32 = ch - 48
            n = n * 10 + digit
        } else {
            break
        }
        i = i + 1
    }

    if is_neg {
        return 0 - n
    }
    return n
}

-- Returns a random 32-bit signed integer using WASI random_get.
pub fn random_i32() i32 {
    var val: i32 = 0
    drop sys_random(&raw val, 4)
    return val
}

-- Returns a pseudo-random integer between min and max (inclusive).
pub fn random_range(min: i32, max: i32) i32 {
    if max <= min {
        return min
    }
    var r: i32 = random_i32()
    if r < 0 {
        r = 0 - r
    }
    var span: i32 = (max - min) + 1
    return min + (r % span)
}
