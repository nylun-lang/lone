-- Lone Standard Library: System & WASI Preview 1 Bridge (:std:sys)
-- Authorizes low-level WebAssembly host syscalls strictly within this module.

---fa:wasm
import .fd_write, .fd_read, .fd_close, .proc_exit, .random_get from :wasi:snapshot_preview1
---

pub var STDIN_FD: i32 = 0
pub var STDOUT_FD: i32 = 1
pub var STDERR_FD: i32 = 2

-- WASI Preview 1 scatter/gather I/O vector (8 bytes: 4-byte linear memory offset + 4-byte length)
pub type Ciovec = struct {
    buf: ptr<u8>,
    len: i32,
}

-- Writes `len` bytes from `buf` to file descriptor `fd` via WASI `fd_write`.
-- Returns the number of bytes written.
pub fn sys_write(fd: i32, buf: ptr<u8>, len: i32) i32 {
    var iov = Ciovec::{
        .buf: buf,
        .len: len,
    }
    var nwritten: i32 = 0
    drop fd_write(fd, &raw iov, 1, &raw nwritten)
    return nwritten
}

-- Reads up to `max_len` bytes from file descriptor `fd` into `buf` via WASI `fd_read`.
-- Returns the number of bytes read (0 on EOF).
pub fn sys_read(fd: i32, buf: ptr<u8>, max_len: i32) i32 {
    var iov = Ciovec::{
        .buf: buf,
        .len: max_len,
    }
    var nread: i32 = 0
    drop fd_read(fd, &raw iov, 1, &raw nread)
    return nread
}

-- Closes file descriptor `fd`.
pub fn sys_close(fd: i32) i32 {
    return fd_close(fd)
}

-- Terminates the WASI process with exit status `code`.
pub fn sys_exit(code: i32) void {
    proc_exit(code)
}

-- Fills `buf` with `len` random bytes via WASI `random_get`.
-- Returns 0 on success.
pub fn sys_random(buf: ptr<any>, len: i32) i32 {
    return random_get(buf, len)
}
