-- Pure-Lone Standard I/O Behavior Test
import .print, .println, .Stdout, .WriterTrait from :std:io

fn main() void {
    print("Hello from ")
    println("Pure Lone std:io!")

    var out = Stdout.new()
    let writer = WriterTrait::|Stdout|
    drop writer.write(out, "Materialized WriterTrait::|Stdout| works!\n")
}
