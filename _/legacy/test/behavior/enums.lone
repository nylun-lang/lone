pub type Color = enum {
    Red,
    Green,
    Blue,
}

pub type Shape = enum {
    Circle(radius: i32),
    Rect(width: i32, height: i32),
    Point,
}

fn describe_color(c: Color) i32 {
    return match c {
        Color::Red => 1,
        Color::Green => 2,
        Color::Blue => 3,
    }
}

fn area(s: Shape) i32 {
    return match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Point => 0,
    }
}

fn main() void {
    let c = Color::Green
    let val = describe_color(c)

    let s1 = Shape::Circle(5)
    let s2 = Shape::Rect(4, 6)
    let s3 = Shape::Point

    let a1 = area(s1)
    let a2 = area(s2)
    let a3 = area(s3)

    if val == 2 and a1 == 75 and a2 == 24 and a3 == 0 {
        #print("Tagged union enums and match pattern extraction verified!\n")
    }
}
